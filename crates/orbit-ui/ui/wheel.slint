import { Theme } from "theme.slint";

export struct WheelSector {
    label: string,
    extension: string,
    category: string,
    color_hex: color,
    pos_x: length,
    pos_y: length,
    angle_deg: float,
    index: int,
    path_commands: string,
    icon_symbol: string,
}

export component RadialWheel inherits Window {
    title: "OrbitConvert Radial Wheel";
    icon: @image-url("../../../assets/app_icon.png");
    no_frame: true;
    background: transparent;
    always_on_top: true;

    width: 360px;
    height: 360px;

    in-out property <string> source_ext: "SVG";
    in-out property <string> source_name: "brand-logo.svg";
    in-out property <int> highlighted_index: -1;
    in-out property <[WheelSector]> sectors: [];
    in-out property <string> status_text: "Convert to...";
    in-out property <bool> is_preview: false;

    callback sector_selected(int);
    callback close_requested();

    // Wheel surface container (340px diameter, centered at 180, 180)
    Rectangle {
        x: 10px;
        y: 10px;
        width: 340px;
        height: 340px;
        border_radius: 170px;
        background: #141820;
        border_width: 1.5px;
        border_color: root.highlighted_index >= 0 ? #248BFF : #2A313E;

        animate border_color { duration: 120ms; }
    }

    // Segmented Donut Wedges
    for sector in root.sectors: Path {
        x: 0px;
        y: 0px;
        width: 360px;
        height: 360px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 360;
        viewbox-height: 360;
        commands: sector.path_commands;
        fill: root.highlighted_index == sector.index ? #248BFF : #252A33;
        stroke: #141820;
        stroke_width: 2px;
    }

    // Format Icons and Labels centered inside each wedge
    for sector in root.sectors: Rectangle {
        x: sector.pos_x - 30px;
        y: sector.pos_y - 26px;
        width: 60px;
        height: 52px;

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: sector.icon_symbol;
                font_size: 15px;
                horizontal_alignment: center;
                vertical_alignment: center;
            }

            Text {
                text: sector.label;
                font_size: 12px;
                font_weight: 800;
                color: root.highlighted_index == sector.index ? #FFFFFF : #C8CDD7;
                horizontal_alignment: center;
                vertical_alignment: center;
            }

            Text {
                text: "." + sector.extension;
                font_size: 10px;
                font_weight: 600;
                color: root.highlighted_index == sector.index ? #FFFFFF : #8C96A8;
                horizontal_alignment: center;
                vertical_alignment: center;
            }
        }
    }

    // Center Hub (145px diameter, centered at 180, 180)
    Rectangle {
        x: 107.5px;
        y: 107.5px;
        width: 145px;
        height: 145px;
        border_radius: 72.5px;
        background: #141820;
        border_width: 2px;
        border_color: root.highlighted_index >= 0 ? #248BFF : #2A313E;

        animate border_color { duration: 120ms; }

        VerticalLayout {
            alignment: center;
            spacing: 5px;
            padding_left: 12px;
            padding_right: 12px;

            // Source format badge - 100% Horizontally and Vertically Centered
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 44px;
                    height: 24px;
                    border_radius: 6px;
                    background: #1e2533;
                    border_width: 1px;
                    border_color: #3b465e;

                    Text {
                        text: root.source_ext;
                        font_size: 11px;
                        font_weight: 800;
                        color: #FFFFFF;
                        horizontal_alignment: center;
                        vertical_alignment: center;
                    }
                }
            }

            // Source file name - 100% Centered
            Text {
                text: root.source_name;
                horizontal_alignment: center;
                vertical_alignment: center;
                font_size: 11px;
                font_weight: 700;
                color: #FFFFFF;
                overflow: elide;
            }

            // Hint / Status text - 100% Centered
            Text {
                text: root.status_text;
                horizontal_alignment: center;
                vertical_alignment: center;
                font_size: 10px;
                font_weight: 500;
                color: root.highlighted_index >= 0 ? #60A5FA : #8C96A8;
                overflow: elide;
            }
        }
    }

    // Preview Mode Notification Banner
    if root.is_preview: Rectangle {
        x: 80px;
        y: 326px;
        width: 200px;
        height: 24px;
        border_radius: 12px;
        background: #1e293b;
        border_width: 1px;
        border_color: #38bdf8;

        TouchArea {
            clicked => { root.close_requested(); }
        }

        Text {
            text: "PREVIEW MODE (Click or Esc to close)";
            font_size: 9px;
            font_weight: 700;
            color: #38bdf8;
            horizontal_alignment: center;
            vertical_alignment: center;
        }
    }
}
