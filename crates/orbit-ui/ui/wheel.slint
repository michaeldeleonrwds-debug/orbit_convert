import { Theme } from "theme.slint";

export struct WheelSector {
    label: string,
    extension: string,
    category: string,
    color_hex: color,
    pos_x: length,
    pos_y: length,
    angle_deg: float,
    index: int,
    path_commands: string,
    icon_symbol: string,
    is_outer: bool,
    is_more: bool,
}

export component RadialWheel inherits Window {
    title: "OrbitConvert Radial Wheel";
    icon: @image-url("../../../assets/app_icon.png");
    no_frame: true;
    background: transparent;
    always_on_top: true;

    width: 460px;
    height: 460px;

    in-out property <string> source_ext: "SVG";
    in-out property <string> source_name: "brand-logo.svg";
    in-out property <string> wheel_mode: "CONVERT"; // "CONVERT" (Wheel A) or "ACTIONS" (Wheel B)
    in-out property <int> highlighted_inner_index: -1;
    in-out property <int> highlighted_outer_index: -1;
    in-out property <bool> is_expanded: false;
    in-out property <[WheelSector]> inner_sectors: [];
    in-out property <[WheelSector]> outer_sectors: [];
    in-out property <string> status_text: "Convert to...";
    in-out property <bool> is_preview: false;

    // Real-time circular loading conversion state
    in-out property <bool> is_converting: false;
    in-out property <float> conversion_progress: 0.0;
    in-out property <string> conversion_status: "Converting...";
    in-out property <string> conversion_target: "PNG";
    in-out property <string> progress_path_commands: "";

    callback sector_selected(int, bool); // index, is_outer
    callback close_requested();
    callback open_all_formats_requested();

    forward-focus: fs_wheel;
    fs_wheel := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close_requested();
                accept
            } else {
                reject
            }
        }
    }

    // -------------------------------------------------------------
    // WHEEL BODY (Visible when NOT converting)
    // -------------------------------------------------------------
    wheel_body := Rectangle {
        x: 0px;
        y: 0px;
        width: 460px;
        height: 460px;
        visible: !root.is_converting;
        background: transparent;

        // -------------------------------------------------------------
        // LEVEL 2: Concentric Outer Ring (Radius 154px - 220px, 440px diameter)
        // -------------------------------------------------------------
        if root.is_expanded: Rectangle {
        x: 0px;
        y: 0px;
        width: 460px;
        height: 460px;

        Rectangle {
            x: 10px;
            y: 10px;
            width: 440px;
            height: 440px;
            border_radius: 220px;
            background: #0d1017;
            border_width: 1px;
            border_color: #1e2638;
        }

        for sector in root.outer_sectors: Path {
            x: 0px;
            y: 0px;
            width: 460px;
            height: 460px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 460;
            viewbox-height: 460;
            commands: sector.path_commands;
            fill: root.highlighted_outer_index == sector.index ? (root.wheel_mode == "ACTIONS" ? #8B5CF6 : #248BFF) : #131824;
            stroke: #0d1017;
            stroke_width: 1.5px;
        }

        for sector in root.outer_sectors: Rectangle {
            x: sector.pos_x - 37px;
            y: sector.pos_y - 25px;
            width: 74px;
            height: 50px;

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                Text {
                    text: sector.icon_symbol;
                    font_size: 13px;
                    horizontal_alignment: center;
                    vertical_alignment: center;
                }

                Text {
                    text: sector.label;
                    font_size: 10px;
                    font_weight: 700;
                    wrap: word-wrap;
                    color: root.highlighted_outer_index == sector.index ? #FFFFFF : #C8CDD7;
                    horizontal_alignment: center;
                    vertical_alignment: center;
                }
            }
        }
    }

    // -------------------------------------------------------------
    // LEVEL 1: Primary Inner Donut Ring (Radius 75px - 150px, 300px diameter)
    // -------------------------------------------------------------
    Rectangle {
        x: 80px;
        y: 80px;
        width: 300px;
        height: 300px;
        border_radius: 150px;
        background: #141824;
        border_width: 1.5px;
        border_color: (root.highlighted_inner_index >= 0) ? (root.wheel_mode == "ACTIONS" ? #8B5CF6 : #248BFF) : #222b3d;

        animate border_color { duration: 120ms; }
    }

    for sector in root.inner_sectors: Path {
        x: 0px;
        y: 0px;
        width: 460px;
        height: 460px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 460;
        viewbox-height: 460;
        commands: sector.path_commands;
        fill: root.highlighted_inner_index == sector.index ? (sector.is_more ? (root.wheel_mode == "ACTIONS" ? #A855F7 : #3B82F6) : (root.wheel_mode == "ACTIONS" ? #8B5CF6 : #248BFF)) : (sector.is_more ? #1e2638 : #181f2c);
        stroke: #0e121a;
        stroke_width: 2px;
    }

    for sector in root.inner_sectors: Rectangle {
        x: sector.pos_x - 39px;
        y: sector.pos_y - 26px;
        width: 78px;
        height: 52px;

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: sector.icon_symbol;
                font_size: 14px;
                horizontal_alignment: center;
                vertical_alignment: center;
            }

            Text {
                text: sector.label;
                font_size: 10.5px;
                font_weight: 800;
                wrap: word-wrap;
                color: root.highlighted_inner_index == sector.index ? #FFFFFF : #C8CDD7;
                horizontal_alignment: center;
                vertical_alignment: center;
            }

            if !sector.is_more: Text {
                text: root.wheel_mode == "ACTIONS" ? sector.extension : ("." + sector.extension);
                font_size: root.wheel_mode == "ACTIONS" ? 8.5px : 9.5px;
                font_weight: 600;
                color: root.highlighted_inner_index == sector.index ? #FFFFFF : #8C96A8;
                horizontal_alignment: center;
                vertical_alignment: center;
                wrap: word-wrap;
            }

            if sector.is_more: Text {
                text: "Expand";
                font_size: 9px;
                font_weight: 600;
                color: root.highlighted_inner_index == sector.index ? #FFFFFF : #38BDF8;
                horizontal_alignment: center;
                vertical_alignment: center;
            }
        }
    }

    // -------------------------------------------------------------
    // CENTER HUB (Radius 72.5px, 145px diameter, centered at 230, 230)
    // -------------------------------------------------------------
    Rectangle {
        x: 157.5px;
        y: 157.5px;
        width: 145px;
        height: 145px;
        border_radius: 72.5px;
        background: #0e121a;
        border_width: 2px;
        border_color: (root.highlighted_inner_index >= 0 || root.highlighted_outer_index >= 0) ? (root.wheel_mode == "ACTIONS" ? #8B5CF6 : #248BFF) : #222b3d;

        animate border_color { duration: 120ms; }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            padding_left: 8px;
            padding_right: 8px;

            // Source format badge - Centered
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: root.wheel_mode == "ACTIONS" ? 72px : 46px;
                    height: 22px;
                    border_radius: 6px;
                    background: #1e2533;
                    border_width: 1px;
                    border_color: root.wheel_mode == "ACTIONS" ? #A855F7 : #38bdf8;

                    Text {
                        text: root.wheel_mode == "ACTIONS" ? "ACTIONS" : root.source_ext;
                        font_size: 11px;
                        font_weight: 800;
                        color: #FFFFFF;
                        horizontal_alignment: center;
                        vertical_alignment: center;
                    }
                }
            }

            // Source file name - Centered
            Text {
                text: root.source_name;
                horizontal_alignment: center;
                vertical_alignment: center;
                font_size: 10.5px;
                font_weight: 700;
                color: #FFFFFF;
                overflow: elide;
            }

            // Status / Hint readout - Centered
            Text {
                text: root.status_text;
                horizontal_alignment: center;
                vertical_alignment: center;
                font_size: 9px;
                font_weight: 600;
                color: (root.highlighted_inner_index >= 0 || root.highlighted_outer_index >= 0 || root.status_text != "Move cursor to format") ? #38BDF8 : #8C96A8;
                wrap: word-wrap;
            }
        }
        TouchArea {
            clicked => {
                if (root.is_preview) {
                    root.close_requested();
                }
            }
        }
    }

    // -------------------------------------------------------------
    // Interactive Preview Notification & All Formats Launcher
    // -------------------------------------------------------------
    if root.is_preview: Rectangle {
        x: 65px;
        y: 422px;
        width: 330px;
        height: 30px;
        border_radius: 15px;
        background: #141b2d;
        border_width: 1px;
        border_color: #38bdf8;

        HorizontalLayout {
            padding_left: 12px;
            padding_right: 8px;
            spacing: 8px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                vertical-stretch: 0;

                TouchArea {
                    clicked => { root.open_all_formats_requested(); }
                }

                Text {
                    text: "🔍 Formats (Ctrl+Shift+Space)";
                    font_size: 10px;
                    font_weight: 700;
                    color: #38bdf8;
                    vertical_alignment: center;
                }
            }

            Rectangle {
                width: 60px;
                height: 22px;
                border_radius: 11px;
                background: #ef444430;
                border_width: 1px;
                border_color: #ef4444;

                TouchArea {
                    clicked => { root.close_requested(); }
                }

                Text {
                    text: "Close (Esc)";
                    font_size: 9.5px;
                    font_weight: 700;
                    color: #fca5a5;
                    horizontal_alignment: center;
                    vertical_alignment: center;
                }
            }
        }
    }
    }

    // -------------------------------------------------------------
    // REAL-TIME CIRCULAR LOADING HUD (0% - 100%)
    // -------------------------------------------------------------
    converting_hud := Rectangle {
        x: 0px;
        y: 0px;
        width: 460px;
        height: 460px;
        visible: root.is_converting;
        background: transparent;

        // Outer Dark Obsidian Panel
        Rectangle {
            x: 135px;
            y: 135px;
            width: 190px;
            height: 190px;
            border_radius: 95px;
            background: #0e121a;
            border_width: 2px;
            border_color: root.conversion_progress >= 1.0 ? #10B981 : (root.wheel_mode == "ACTIONS" ? #8B5CF6 : #248BFF);

            animate border_color { duration: 150ms; }
        }

        // Circular background track ring (diameter 150px, radius 75px, centered at 230, 230)
        Rectangle {
            x: 155px;
            y: 155px;
            width: 150px;
            height: 150px;
            border_radius: 75px;
            border_width: 8px;
            border_color: #1e2638;
            background: transparent;
        }

        // Realtime SVG Progress Arc (radius 75px, stroke_width 8px)
        Path {
            x: 0px;
            y: 0px;
            width: 460px;
            height: 460px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 460;
            viewbox-height: 460;
            commands: root.progress_path_commands;
            stroke: root.conversion_progress >= 1.0 ? #10B981 : (root.wheel_mode == "ACTIONS" ? #8B5CF6 : #248BFF);
            stroke_width: 8px;
            fill: transparent;

            animate stroke { duration: 150ms; }
        }

        // Realtime Conversion Details Inside Ring
        VerticalLayout {
            x: 155px;
            y: 155px;
            width: 150px;
            height: 150px;
            alignment: center;
            spacing: 5px;
            padding_left: 8px;
            padding_right: 8px;

            // Target Badge
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: root.wheel_mode == "ACTIONS" ? 76px : 52px;
                    height: 22px;
                    border_radius: 6px;
                    background: #192233;
                    border_width: 1px;
                    border_color: root.conversion_progress >= 1.0 ? #10B981 : (root.wheel_mode == "ACTIONS" ? #A855F7 : #38bdf8);

                    Text {
                        text: root.conversion_target;
                        font_size: 11px;
                        font_weight: 800;
                        color: #FFFFFF;
                        horizontal_alignment: center;
                        vertical_alignment: center;
                    }
                }
            }

            // Real-time Percentage Typography
            Text {
                text: Math.round(root.conversion_progress * 100.0) + "%";
                font_size: 26px;
                font_weight: 900;
                color: root.conversion_progress >= 1.0 ? #10B981 : #FFFFFF;
                horizontal_alignment: center;
                vertical_alignment: center;

                animate color { duration: 150ms; }
            }

            // Real-time Status / Caption
            Text {
                text: root.conversion_status;
                font_size: 10px;
                font_weight: 700;
                color: root.conversion_progress >= 1.0 ? #34D399 : #94A3B8;
                horizontal_alignment: center;
                vertical_alignment: center;
                overflow: elide;
            }
        }
    }
}
