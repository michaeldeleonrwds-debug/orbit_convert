import { Theme } from "theme.slint";

export component AppButton inherits Rectangle {
    in property <string> text: "Action";
    in property <string> icon_text: "";
    in property <bool> is_primary: true;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border_radius: 6px;

    background: !root.enabled ? #1a202c :
        touch.pressed ? (root.is_primary ? #1a74e2 : #151a24) :
        touch.has_hover ? (root.is_primary ? #3b9eff : #242c3d) :
        (root.is_primary ? #248bff : #1c2230);

    border_width: root.is_primary ? 0px : 1px;
    border_color: touch.has_hover ? #38455e : #2b3447;

    animate background { duration: 100ms; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding_left: 14px;
        padding_right: 14px;
        spacing: 8px;
        alignment: center;

        if root.icon_text != "": Text {
            text: root.icon_text;
            font_size: 14px;
            font_weight: 700;
            color: !root.enabled ? #64748b : #ffffff;
            vertical_alignment: center;
        }

        Text {
            text: root.text;
            font_size: 13px;
            font_weight: 600;
            color: !root.enabled ? #64748b : #ffffff;
            vertical_alignment: center;
        }
    }
}

export component SecondaryButton inherits Rectangle {
    in property <string> text: "Button";
    in property <string> icon_text: "";
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border_radius: 5px;

    background: touch.pressed ? #141923 :
        touch.has_hover ? #242c3d :
        #1a202c;

    border_width: 1px;
    border_color: touch.has_hover ? #3c4860 : #2b3447;

    animate background { duration: 90ms; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding_left: 10px;
        padding_right: 10px;
        spacing: 6px;
        alignment: center;

        if root.icon_text != "": Text {
            text: root.icon_text;
            font_size: 12px;
            color: #94a3b8;
            vertical_alignment: center;
        }

        Text {
            text: root.text;
            font_size: 12px;
            font_weight: 600;
            color: #cbd5e1;
            vertical_alignment: center;
        }
    }
}

export component DangerButton inherits Rectangle {
    in property <string> text: "Delete";
    callback clicked();

    height: 30px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border_radius: 5px;

    background: touch.pressed ? #2d0f12 :
        touch.has_hover ? #47151a :
        #351115;

    border_width: 1px;
    border_color: touch.has_hover ? #82272d : #5c1d22;

    animate background { duration: 90ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding_left: 10px;
        padding_right: 10px;
        alignment: center;

        Text {
            text: root.text;
            font_size: 11px;
            font_weight: 600;
            color: #f87171;
            vertical_alignment: center;
        }
    }
}

export component StatusBadge inherits Rectangle {
    in property <string> text: "READY";
    in property <color> badge_color: #248bff;
    in property <color> text_color: #ffffff;

    height: 20px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border_radius: 4px;
    background: root.badge_color;

    HorizontalLayout {
        padding_left: 6px;
        padding_right: 6px;
        alignment: center;

        Text {
            text: root.text;
            font_size: 10px;
            font_weight: 700;
            color: root.text_color;
            vertical_alignment: center;
        }
    }
}

export component Card inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";

    background: #141822;
    border_width: 1px;
    border_color: #1f2636;
    border_radius: 8px;
    vertical-stretch: 0;
}

export component AppSlider inherits Rectangle {
    in property <float> minimum: 0.0;
    in property <float> maximum: 100.0;
    in-out property <float> value: 50.0;
    callback changed(float);

    height: 24px;
    vertical-stretch: 0;
    background: transparent;

    Rectangle {
        y: (parent.height - 6px) / 2;
        height: 6px;
        width: 100%;
        background: #1e2638;
        border-radius: 3px;

        // Active fill in electric blue
        Rectangle {
            x: 0;
            width: Math.max(0px, Math.min(parent.width, parent.width * ((root.value - root.minimum) / Math.max(0.001, root.maximum - root.minimum))));
            height: 100%;
            background: #248BFF;
            border-radius: 3px;
        }
    }

    // Thumb handle
    Rectangle {
        x: Math.max(0px, Math.min(parent.width - 16px, (parent.width - 16px) * ((root.value - root.minimum) / Math.max(0.001, root.maximum - root.minimum))));
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border_radius: 8px;
        background: #FFFFFF;
        border-width: 2px;
        border-color: #248BFF;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000080;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        moved => {
            if self.pressed {
                let ratio = Math.max(0.0, Math.min(1.0, self.mouse-x / parent.width));
                root.value = root.minimum + ratio * (root.maximum - root.minimum);
                root.changed(root.value);
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                let ratio = Math.max(0.0, Math.min(1.0, self.mouse-x / parent.width));
                root.value = root.minimum + ratio * (root.maximum - root.minimum);
                root.changed(root.value);
            }
        }
    }
}

export component AppCheckBox inherits Rectangle {
    in property <string> text: "";
    in-out property <bool> checked: false;
    callback toggled(bool);

    height: 26px;
    vertical-stretch: 0;
    background: transparent;

    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    HorizontalLayout {
        spacing: 10px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border_radius: 4px;
                background: root.checked ? #248BFF : #161D2B;
                border_width: 1px;
                border_color: root.checked ? #248BFF : #2A364E;

                animate background { duration: 100ms; }

                if root.checked: Text {
                    text: "✓";
                    font_size: 11px;
                    font_weight: 800;
                    color: #FFFFFF;
                    horizontal_alignment: center;
                    vertical_alignment: center;
                }
            }
        }

        Text {
            text: root.text;
            font_size: 13px;
            font_weight: 500;
            color: #C8CDD7;
            vertical_alignment: center;
        }
    }
}

export component SearchInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "Search formats...";
    callback changed(string);
    callback accepted(string);

    height: 38px;
    border_radius: 6px;
    background: #0d1017;
    border_width: 1px;
    border_color: input.has_focus ? #248BFF : #1e2638;

    HorizontalLayout {
        padding_left: 12px;
        padding_right: 12px;
        spacing: 10px;
        alignment: center;

        Text {
            text: "🔍";
            font_size: 13px;
            vertical_alignment: center;
        }

        input := TextInput {
            width: 100%;
            font_size: 13px;
            color: #FFFFFF;
            vertical_alignment: center;
            single_line: true;
            edited => { root.changed(self.text); }
            accepted => { root.accepted(self.text); }
        }
    }
}

