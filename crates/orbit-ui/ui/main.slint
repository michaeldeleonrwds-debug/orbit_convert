import { Theme } from "theme.slint";
import { RadialWheel, WheelSector } from "wheel.slint";
import { Button, CheckBox, Slider, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";

export { RadialWheel, WheelSector }

export struct FolderItem {
    id: string,
    name: string,
    path: string,
    enabled: bool,
    is_watched: bool,
}

export struct HistoryItem {
    id: int,
    source_name: string,
    source_ext: string,
    target_ext: string,
    output_path: string,
    duration_ms: int,
    is_success: bool,
    status_text: string,
}

export struct PresetItem {
    id: string,
    name: string,
    desc: string,
    target_format: string,
    quality: int,
    svg_scale: float,
}

export component MainWindow inherits Window {
    title: "OrbitConvert — Fast, Powerful File Conversion";
    icon: @image-url("../../../assets/app_icon.png");
    min_width: 1100px;
    min_height: 700px;
    preferred_width: 1360px;
    preferred_height: 860px;
    background: Theme.bg_root;

    // Navigation state
    in-out property <int> selected_nav: 0; // 0=Dashboard, 1=Convert, 2=History, 3=Folders, 4=Presets, 5=Settings

    // Dashboard & Settings state
    in-out property <string> shortcut_label: "Hold Left Alt key";
    in-out property <string> output_folder_label: "Same as source file";
    in-out property <int> jpeg_quality: 90;
    in-out property <float> svg_scale: 1.0;
    in-out property <bool> show_notifications: true;
    in-out property <bool> launch_on_startup: false;
    in-out property <bool> minimize_to_tray: true;
    in-out property <bool> service_active: true;
    in-out property <string> output_mode: "source";

    // Folders model
    in-out property <[FolderItem]> folders: [];

    // History model
    in-out property <[HistoryItem]> history: [];

    // Presets model
    in-out property <[PresetItem]> presets: [];

    // Manual Convert Page State
    in-out property <string> convert_source_path: "";
    in-out property <string> convert_source_name: "No file selected";
    in-out property <string> convert_source_ext: "NONE";
    in-out property <string> convert_target_fmt: "PNG";
    in-out property <float> convert_progress: 0.0;
    in-out property <bool> is_converting: false;
    in-out property <string> convert_status_msg: "Ready to convert";
    in-out property <string> convert_last_output: "";

    // Callbacks
    callback nav_clicked(int);
    callback add_folder_clicked();
    callback toggle_folder(string, bool);
    callback remove_folder(string);
    callback open_folder_path(string);
    callback browse_file_clicked();
    callback select_target_format(string);
    callback start_manual_conversion();
    callback open_output_file(string);
    callback clear_history_clicked();
    callback apply_preset_clicked(string);
    callback save_settings_clicked();
    callback run_diagnostics_clicked();
    callback choose_custom_output_clicked();
    callback toggle_service_clicked();

    HorizontalLayout {
        // ==================== SIDEBAR ====================
        Rectangle {
            width: 240px;
            background: Theme.bg_sidebar;
            border_width: 1px;
            border_color: Theme.border_subtle;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                // Brand Header
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Image {
                        source: @image-url("../../../assets/app_icon.png");
                        width: 36px;
                        height: 36px;
                        image-fit: contain;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;

                        Text {
                            text: "OrbitConvert";
                            font_size: 16px;
                            font_weight: 800;
                            color: Theme.text_primary;
                        }

                        Text {
                            text: "ANY FILE. ANY FORMAT.";
                            font_size: 8px;
                            font_weight: 600;
                            color: Theme.text_muted;
                            letter_spacing: 0.5px;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border_subtle;
                }

                // Nav Items
                VerticalLayout {
                    spacing: 6px;

                    // 0: Dashboard
                    Rectangle {
                        height: 42px;
                        border_radius: 8px;
                        background: root.selected_nav == 0 ? Theme.accent_blue : transparent;

                        TouchArea {
                            clicked => { root.selected_nav = 0; root.nav_clicked(0); }
                        }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "✦";
                                font_size: 14px;
                                color: root.selected_nav == 0 ? #ffffff : Theme.text_secondary;
                                vertical_alignment: center;
                            }

                            Text {
                                text: "Dashboard";
                                font_size: 13px;
                                font_weight: root.selected_nav == 0 ? 700 : 500;
                                color: root.selected_nav == 0 ? #ffffff : Theme.text_secondary;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // 1: Convert
                    Rectangle {
                        height: 42px;
                        border_radius: 8px;
                        background: root.selected_nav == 1 ? Theme.accent_blue : transparent;

                        TouchArea {
                            clicked => { root.selected_nav = 1; root.nav_clicked(1); }
                        }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "↻";
                                font_size: 16px;
                                font_weight: 700;
                                color: root.selected_nav == 1 ? #ffffff : Theme.text_secondary;
                                vertical_alignment: center;
                            }

                            Text {
                                text: "Convert";
                                font_size: 13px;
                                font_weight: root.selected_nav == 1 ? 700 : 500;
                                color: root.selected_nav == 1 ? #ffffff : Theme.text_secondary;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // 2: History
                    Rectangle {
                        height: 42px;
                        border_radius: 8px;
                        background: root.selected_nav == 2 ? Theme.accent_blue : transparent;

                        TouchArea {
                            clicked => { root.selected_nav = 2; root.nav_clicked(2); }
                        }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "◷";
                                font_size: 14px;
                                color: root.selected_nav == 2 ? #ffffff : Theme.text_secondary;
                                vertical_alignment: center;
                            }

                            Text {
                                text: "History";
                                font_size: 13px;
                                font_weight: root.selected_nav == 2 ? 700 : 500;
                                color: root.selected_nav == 2 ? #ffffff : Theme.text_secondary;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // 3: Folders
                    Rectangle {
                        height: 42px;
                        border_radius: 8px;
                        background: root.selected_nav == 3 ? Theme.accent_blue : transparent;

                        TouchArea {
                            clicked => { root.selected_nav = 3; root.nav_clicked(3); }
                        }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "📁";
                                font_size: 13px;
                                vertical_alignment: center;
                            }

                            Text {
                                text: "Folders";
                                font_size: 13px;
                                font_weight: root.selected_nav == 3 ? 700 : 500;
                                color: root.selected_nav == 3 ? #ffffff : Theme.text_secondary;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // 4: Presets
                    Rectangle {
                        height: 42px;
                        border_radius: 8px;
                        background: root.selected_nav == 4 ? Theme.accent_blue : transparent;

                        TouchArea {
                            clicked => { root.selected_nav = 4; root.nav_clicked(4); }
                        }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "⚙";
                                font_size: 14px;
                                color: root.selected_nav == 4 ? #ffffff : Theme.text_secondary;
                                vertical_alignment: center;
                            }

                            Text {
                                text: "Presets";
                                font_size: 13px;
                                font_weight: root.selected_nav == 4 ? 700 : 500;
                                color: root.selected_nav == 4 ? #ffffff : Theme.text_secondary;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // 5: Settings
                    Rectangle {
                        height: 42px;
                        border_radius: 8px;
                        background: root.selected_nav == 5 ? Theme.accent_blue : transparent;

                        TouchArea {
                            clicked => { root.selected_nav = 5; root.nav_clicked(5); }
                        }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "⚒";
                                font_size: 14px;
                                color: root.selected_nav == 5 ? #ffffff : Theme.text_secondary;
                                vertical_alignment: center;
                            }

                            Text {
                                text: "Settings";
                                font_size: 13px;
                                font_weight: root.selected_nav == 5 ? 700 : 500;
                                color: root.selected_nav == 5 ? #ffffff : Theme.text_secondary;
                                vertical_alignment: center;
                            }
                        }
                    }
                }

                // Push status card to bottom
                Rectangle {
                    vertical_stretch: 1;
                }

                // Service Status Card
                Rectangle {
                    height: 72px;
                    border_radius: 10px;
                    background: #141722;
                    border_width: 1px;
                    border_color: #232734;

                    TouchArea {
                        clicked => { root.toggle_service_clicked(); }
                    }

                    HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        alignment: center;

                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border_radius: 5px;
                            background: root.service_active ? Theme.status_green : #6b7280;
                        }

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: root.service_active ? "Service Active" : "Service Paused";
                                font_size: 12px;
                                font_weight: 700;
                                color: root.service_active ? Theme.status_green : Theme.text_muted;
                            }
                            Text {
                                text: "Hold Alt in File Explorer";
                                font_size: 10px;
                                color: Theme.text_secondary;
                            }
                        }

                        Text {
                            text: "›";
                            font_size: 18px;
                            color: Theme.text_muted;
                            vertical_alignment: center;
                        }
                    }
                }
            }
        }

        // ==================== MAIN CONTENT AREA ====================
        VerticalLayout {
            horizontal_stretch: 1;

            // Top Header Bar
            Rectangle {
                height: 70px;
                background: Theme.bg_header;
                border_width: 1px;
                border_color: Theme.border_subtle;

                HorizontalLayout {
                    padding_left: 32px;
                    padding_right: 32px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: root.selected_nav == 0 ? "Welcome to OrbitConvert" :
                                  root.selected_nav == 1 ? "Manual Conversion Studio" :
                                  root.selected_nav == 2 ? "Conversion History" :
                                  root.selected_nav == 3 ? "Managed Folders" :
                                  root.selected_nav == 4 ? "Conversion Presets" : "Application Preferences";
                            font_size: 20px;
                            font_weight: 800;
                            color: Theme.text_primary;
                        }

                        Text {
                            text: root.selected_nav == 0 ? "Fast. Powerful. Professional file conversion." :
                                  root.selected_nav == 1 ? "Convert images, vectors, and documents directly." :
                                  root.selected_nav == 2 ? "Real-time record of all completed file transformations." :
                                  root.selected_nav == 3 ? "Configure watched directories and output destinations." :
                                  root.selected_nav == 4 ? "One-click reusable format and quality recipes." :
                                  "Configure hotkeys, overlay radius, image fidelity, and startup.";
                            font_size: 12px;
                            color: Theme.text_secondary;
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 12px;

                        // Diagnostic Button
                        Button {
                            text: "⚙ Diagnostics";
                            clicked => { root.run_diagnostics_clicked(); }
                        }
                    }
                }
            }

            // Scrollable Content View
            ScrollView {
                // PAGE 0: DASHBOARD
                if root.selected_nav == 0: VerticalLayout {
                    spacing: 24px;

                    // Category Cards Row (Reference mockup 6 cards)
                    HorizontalLayout {
                        spacing: 14px;

                        // Images (Active)
                        Rectangle {
                            horizontal_stretch: 1;
                            height: 110px;
                            border_radius: 12px;
                            background: Theme.bg_card;
                            border_width: 1.5px;
                            border_color: #1e3a8a;

                            TouchArea {
                                clicked => { root.selected_nav = 1; root.nav_clicked(1); }
                            }

                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border_radius: 6px;
                                        background: #2563eb;
                                        Text {
                                            text: "🖼";
                                            font_size: 14px;
                                            horizontal_alignment: center;
                                            vertical_alignment: center;
                                        }
                                    }
                                    Text {
                                        text: "Images";
                                        font_size: 14px;
                                        font_weight: 700;
                                        color: #ffffff;
                                        vertical_alignment: center;
                                    }
                                }

                                Text {
                                    text: "SVG, PNG, JPG, WebP, ICO, BMP, TIFF";
                                    font_size: 10px;
                                    color: #94a3b8;
                                    overflow: elide;
                                }

                                Text {
                                    text: "● Installed & Ready";
                                    font_size: 9px;
                                    font_weight: 700;
                                    color: #10b981;
                                }
                            }
                        }

                        // Video (Disabled)
                        Rectangle {
                            horizontal_stretch: 1;
                            height: 110px;
                            border_radius: 12px;
                            background: Theme.bg_card;
                            border_width: 1px;
                            border_color: Theme.border_subtle;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border_radius: 6px;
                                        background: #7c3aed33;
                                        Text {
                                            text: "▶";
                                            font_size: 12px;
                                            color: #a78bfa;
                                            horizontal_alignment: center;
                                            vertical_alignment: center;
                                        }
                                    }
                                    Text {
                                        text: "Video";
                                        font_size: 14px;
                                        font_weight: 700;
                                        color: #64748b;
                                        vertical_alignment: center;
                                    }
                                }

                                Text {
                                    text: "MP4, MOV, MKV, WebM, AVI";
                                    font_size: 10px;
                                    color: #475569;
                                    overflow: elide;
                                }

                                Text {
                                    text: "Requires FFmpeg Adapter";
                                    font_size: 9px;
                                    color: #64748b;
                                }
                            }
                        }

                        // Audio (Disabled)
                        Rectangle {
                            horizontal_stretch: 1;
                            height: 110px;
                            border_radius: 12px;
                            background: Theme.bg_card;
                            border_width: 1px;
                            border_color: Theme.border_subtle;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border_radius: 6px;
                                        background: #e11d4833;
                                        Text {
                                            text: "♫";
                                            font_size: 14px;
                                            color: #fb7185;
                                            horizontal_alignment: center;
                                            vertical_alignment: center;
                                        }
                                    }
                                    Text {
                                        text: "Audio";
                                        font_size: 14px;
                                        font_weight: 700;
                                        color: #64748b;
                                        vertical_alignment: center;
                                    }
                                }

                                Text {
                                    text: "MP3, WAV, FLAC, AAC, OGG";
                                    font_size: 10px;
                                    color: #475569;
                                    overflow: elide;
                                }

                                Text {
                                    text: "Requires Audio Adapter";
                                    font_size: 9px;
                                    color: #64748b;
                                }
                            }
                        }

                        // Documents (Disabled)
                        Rectangle {
                            horizontal_stretch: 1;
                            height: 110px;
                            border_radius: 12px;
                            background: Theme.bg_card;
                            border_width: 1px;
                            border_color: Theme.border_subtle;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border_radius: 6px;
                                        background: #ea580c33;
                                        Text {
                                            text: "📄";
                                            font_size: 13px;
                                            horizontal_alignment: center;
                                            vertical_alignment: center;
                                        }
                                    }
                                    Text {
                                        text: "Documents";
                                        font_size: 14px;
                                        font_weight: 700;
                                        color: #64748b;
                                        vertical_alignment: center;
                                    }
                                }

                                Text {
                                    text: "PDF, DOCX, ODT, PPTX, TXT";
                                    font_size: 10px;
                                    color: #475569;
                                    overflow: elide;
                                }

                                Text {
                                    text: "Requires Doc Adapter";
                                    font_size: 9px;
                                    color: #64748b;
                                }
                            }
                        }

                        // Spreadsheets (Disabled)
                        Rectangle {
                            horizontal_stretch: 1;
                            height: 110px;
                            border_radius: 12px;
                            background: Theme.bg_card;
                            border_width: 1px;
                            border_color: Theme.border_subtle;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border_radius: 6px;
                                        background: #05966933;
                                        Text {
                                            text: "📊";
                                            font_size: 13px;
                                            horizontal_alignment: center;
                                            vertical_alignment: center;
                                        }
                                    }
                                    Text {
                                        text: "Spreadsheets";
                                        font_size: 14px;
                                        font_weight: 700;
                                        color: #64748b;
                                        vertical_alignment: center;
                                    }
                                }

                                Text {
                                    text: "CSV, XLSX, ODS, TSV, JSON";
                                    font_size: 10px;
                                    color: #475569;
                                    overflow: elide;
                                }

                                Text {
                                    text: "Requires Sheet Adapter";
                                    font_size: 9px;
                                    color: #64748b;
                                }
                            }
                        }

                        // Archives (Disabled)
                        Rectangle {
                            horizontal_stretch: 1;
                            height: 110px;
                            border_radius: 12px;
                            background: Theme.bg_card;
                            border_width: 1px;
                            border_color: Theme.border_subtle;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border_radius: 6px;
                                        background: #d9770633;
                                        Text {
                                            text: "🗄";
                                            font_size: 13px;
                                            horizontal_alignment: center;
                                            vertical_alignment: center;
                                        }
                                    }
                                    Text {
                                        text: "Archives";
                                        font_size: 14px;
                                        font_weight: 700;
                                        color: #64748b;
                                        vertical_alignment: center;
                                    }
                                }

                                Text {
                                    text: "ZIP, 7Z, RAR, TAR, GZ";
                                    font_size: 10px;
                                    color: #475569;
                                    overflow: elide;
                                }

                                Text {
                                    text: "Requires Archive Adapter";
                                    font_size: 9px;
                                    color: #64748b;
                                }
                            }
                        }
                    }

                    // Two Columns: Watched Folders (Left) & Quick Settings (Right)
                    HorizontalLayout {
                        spacing: 20px;

                        // Left Column: Watched Folders
                        Rectangle {
                            horizontal_stretch: 6;
                            border_radius: 12px;
                            background: Theme.bg_card;
                            border_width: 1px;
                            border_color: Theme.border_subtle;

                            VerticalLayout {
                                padding: 20px;
                                spacing: 14px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "📁 Watched Folders";
                                            font_size: 15px;
                                            font_weight: 700;
                                            color: #ffffff;
                                        }
                                        Text {
                                            text: "Monitor directories and access them quickly.";
                                            font_size: 11px;
                                            color: Theme.text_secondary;
                                        }
                                    }

                                    Button {
                                        text: "+ Add Folder";
                                        primary: true;
                                        clicked => { root.add_folder_clicked(); }
                                    }
                                }

                                Rectangle {
                                    height: 1px;
                                    background: Theme.border_subtle;
                                }

                                // Folder items list
                                for folder in root.folders: Rectangle {
                                    height: 52px;
                                    border_radius: 8px;
                                    background: #181b24;
                                    border_width: 1px;
                                    border_color: #242938;

                                    HorizontalLayout {
                                        padding_left: 14px;
                                        padding_right: 14px;
                                        spacing: 12px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            Text {
                                                text: "📁";
                                                font_size: 16px;
                                                vertical_alignment: center;
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 1px;
                                                Text {
                                                    text: folder.name;
                                                    font_size: 13px;
                                                    font_weight: 600;
                                                    color: #f8fafc;
                                                }
                                                Text {
                                                    text: folder.path;
                                                    font_size: 10px;
                                                    color: #94a3b8;
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: end;

                                            CheckBox {
                                                checked: folder.enabled;
                                                toggled => { root.toggle_folder(folder.id, self.checked); }
                                            }

                                            Button {
                                                text: "Open";
                                                clicked => { root.open_folder_path(folder.path); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Right Column: Quick Settings
                        Rectangle {
                            horizontal_stretch: 5;
                            border_radius: 12px;
                            background: Theme.bg_card;
                            border_width: 1px;
                            border_color: Theme.border_subtle;

                            VerticalLayout {
                                padding: 20px;
                                spacing: 14px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "⚙ Quick Settings";
                                        font_size: 15px;
                                        font_weight: 700;
                                        color: #ffffff;
                                    }
                                    Button {
                                        text: "View All";
                                        clicked => { root.selected_nav = 5; root.nav_clicked(5); }
                                    }
                                }

                                Rectangle {
                                    height: 1px;
                                    background: Theme.border_subtle;
                                }

                                // Trigger Row
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Activation Shortcut:";
                                        font_size: 12px;
                                        color: Theme.text_secondary;
                                        vertical_alignment: center;
                                    }
                                    Rectangle {
                                        height: 24px;
                                        border_radius: 4px;
                                        background: #1e293b;
                                        border_width: 1px;
                                        border_color: #3b82f6;
                                        HorizontalLayout {
                                            padding_left: 8px;
                                            padding_right: 8px;
                                            Text {
                                                text: "Alt (Hold in Explorer)";
                                                font_size: 11px;
                                                font_weight: 700;
                                                color: #60a5fa;
                                                vertical_alignment: center;
                                            }
                                        }
                                    }
                                }

                                // Output Directory Row
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Default Output Folder:";
                                        font_size: 12px;
                                        color: Theme.text_secondary;
                                        vertical_alignment: center;
                                    }
                                    Text {
                                        text: root.output_folder_label;
                                        font_size: 12px;
                                        font_weight: 600;
                                        color: #f1f5f9;
                                        vertical_alignment: center;
                                        overflow: elide;
                                    }
                                }

                                // Quality Slider
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "Image Quality (JPEG / WebP):";
                                            font_size: 12px;
                                            color: Theme.text_secondary;
                                        }
                                        Text {
                                            text: root.jpeg_quality + "%";
                                            font_size: 12px;
                                            font_weight: 700;
                                            color: #93c5fd;
                                        }
                                    }
                                    Slider {
                                        minimum: 50;
                                        maximum: 100;
                                        value: root.jpeg_quality;
                                        changed(val) => { root.jpeg_quality = Math.round(val); }
                                    }
                                }

                                // SVG Scale Slider
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "SVG Rasterization Scale:";
                                            font_size: 12px;
                                            color: Theme.text_secondary;
                                        }
                                        Text {
                                            text: root.svg_scale + "x";
                                            font_size: 12px;
                                            font_weight: 700;
                                            color: #93c5fd;
                                        }
                                    }
                                    Slider {
                                        minimum: 1.0;
                                        maximum: 4.0;
                                        value: root.svg_scale;
                                        changed(val) => { root.svg_scale = Math.round(val * 10) / 10; }
                                    }
                                }

                                // Notifications
                                CheckBox {
                                    text: "Show Windows completion notifications";
                                    checked: root.show_notifications;
                                    toggled => { root.show_notifications = self.checked; }
                                }
                            }
                        }
                    }
                }

                // PAGE 1: MANUAL CONVERT
                if root.selected_nav == 1: VerticalLayout {
                    spacing: 20px;

                    // Source File Picker Card
                    Rectangle {
                        border_radius: 12px;
                        background: Theme.bg_card;
                        border_width: 1px;
                        border_color: Theme.border_subtle;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;

                            Text {
                                text: "Select Source File";
                                font_size: 16px;
                                font_weight: 700;
                                color: #ffffff;
                            }

                            Rectangle {
                                height: 110px;
                                border_radius: 10px;
                                background: #11131a;
                                border_width: 1.5px;
                                border_color: #2b3244;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;

                                    Text {
                                        text: root.convert_source_path != "" ? root.convert_source_path : "Click Browse to select an SVG, PNG, JPG, or WebP file";
                                        font_size: 13px;
                                        color: root.convert_source_path != "" ? #60a5fa : #94a3b8;
                                        horizontal_alignment: center;
                                    }

                                    Button {
                                        text: "📂 Browse File...";
                                        primary: true;
                                        clicked => { root.browse_file_clicked(); }
                                    }
                                }
                            }
                        }
                    }

                    // Target Format Selector Card
                    Rectangle {
                        border_radius: 12px;
                        background: Theme.bg_card;
                        border_width: 1px;
                        border_color: Theme.border_subtle;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;

                            Text {
                                text: "Target Output Format";
                                font_size: 16px;
                                font_weight: 700;
                                color: #ffffff;
                            }

                            HorizontalLayout {
                                spacing: 12px;

                                // PNG Button
                                Rectangle {
                                    horizontal_stretch: 1;
                                    height: 54px;
                                    border_radius: 8px;
                                    background: root.convert_target_fmt == "PNG" ? #1e3a8a : #181b26;
                                    border_width: root.convert_target_fmt == "PNG" ? 2px : 1px;
                                    border_color: root.convert_target_fmt == "PNG" ? #3b82f6 : #2a2f3f;

                                    TouchArea {
                                        clicked => { root.convert_target_fmt = "PNG"; root.select_target_format("PNG"); }
                                    }

                                    Text {
                                        text: "PNG";
                                        font_size: 14px;
                                        font_weight: 700;
                                        color: root.convert_target_fmt == "PNG" ? #ffffff : #94a3b8;
                                        horizontal_alignment: center;
                                        vertical_alignment: center;
                                    }
                                }

                                // JPG Button
                                Rectangle {
                                    horizontal_stretch: 1;
                                    height: 54px;
                                    border_radius: 8px;
                                    background: root.convert_target_fmt == "JPG" ? #7c2d12 : #181b26;
                                    border_width: root.convert_target_fmt == "JPG" ? 2px : 1px;
                                    border_color: root.convert_target_fmt == "JPG" ? #ea580c : #2a2f3f;

                                    TouchArea {
                                        clicked => { root.convert_target_fmt = "JPG"; root.select_target_format("JPG"); }
                                    }

                                    Text {
                                        text: "JPG";
                                        font_size: 14px;
                                        font_weight: 700;
                                        color: root.convert_target_fmt == "JPG" ? #ffffff : #94a3b8;
                                        horizontal_alignment: center;
                                        vertical_alignment: center;
                                    }
                                }

                                // WEBP Button
                                Rectangle {
                                    horizontal_stretch: 1;
                                    height: 54px;
                                    border_radius: 8px;
                                    background: root.convert_target_fmt == "WEBP" ? #064e3b : #181b26;
                                    border_width: root.convert_target_fmt == "WEBP" ? 2px : 1px;
                                    border_color: root.convert_target_fmt == "WEBP" ? #10b981 : #2a2f3f;

                                    TouchArea {
                                        clicked => { root.convert_target_fmt = "WEBP"; root.select_target_format("WEBP"); }
                                    }

                                    Text {
                                        text: "WEBP";
                                        font_size: 14px;
                                        font_weight: 700;
                                        color: root.convert_target_fmt == "WEBP" ? #ffffff : #94a3b8;
                                        horizontal_alignment: center;
                                        vertical_alignment: center;
                                    }
                                }

                                // ICO Button
                                Rectangle {
                                    horizontal_stretch: 1;
                                    height: 54px;
                                    border_radius: 8px;
                                    background: root.convert_target_fmt == "ICO" ? #4c1d95 : #181b26;
                                    border_width: root.convert_target_fmt == "ICO" ? 2px : 1px;
                                    border_color: root.convert_target_fmt == "ICO" ? #8b5cf6 : #2a2f3f;

                                    TouchArea {
                                        clicked => { root.convert_target_fmt = "ICO"; root.select_target_format("ICO"); }
                                    }

                                    Text {
                                        text: "ICO";
                                        font_size: 14px;
                                        font_weight: 700;
                                        color: root.convert_target_fmt == "ICO" ? #ffffff : #94a3b8;
                                        horizontal_alignment: center;
                                        vertical_alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Action & Result Card
                    Rectangle {
                        border_radius: 12px;
                        background: Theme.bg_card;
                        border_width: 1px;
                        border_color: Theme.border_subtle;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;

                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: root.convert_status_msg;
                                        font_size: 14px;
                                        font_weight: 600;
                                        color: #ffffff;
                                    }
                                    Text {
                                        text: root.convert_last_output != "" ? "Output: " + root.convert_last_output : "No file generated yet.";
                                        font_size: 12px;
                                        color: #94a3b8;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;

                                    if root.convert_last_output != "": Button {
                                        text: "Open Converted File";
                                        clicked => { root.open_output_file(root.convert_last_output); }
                                    }

                                    Button {
                                        text: root.is_converting ? "Converting..." : "Convert Now 🚀";
                                        primary: true;
                                        enabled: root.convert_source_path != "" && !root.is_converting;
                                        clicked => { root.start_manual_conversion(); }
                                    }
                                }
                            }
                        }
                    }
                }

                // PAGE 2: HISTORY
                if root.selected_nav == 2: VerticalLayout {
                    spacing: 16px;

                    Rectangle {
                        border_radius: 12px;
                        background: Theme.bg_card;
                        border_width: 1px;
                        border_color: Theme.border_subtle;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Recent Conversions";
                                    font_size: 16px;
                                    font_weight: 700;
                                    color: #ffffff;
                                }
                                Button {
                                    text: "Clear History";
                                    clicked => { root.clear_history_clicked(); }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border_subtle;
                            }

                            if root.history.length == 0: Text {
                                text: "No conversion history yet. Use the radial wheel (Hold Alt in Explorer) or Convert studio!";
                                font_size: 13px;
                                color: Theme.text_muted;
                            }

                            for item in root.history: Rectangle {
                                height: 60px;
                                border_radius: 8px;
                                background: #161922;
                                border_width: 1px;
                                border_color: #232736;

                                HorizontalLayout {
                                    padding_left: 16px;
                                    padding_right: 16px;
                                    spacing: 12px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text {
                                            text: item.is_success ? "✓" : "✗";
                                            font_size: 16px;
                                            font_weight: 800;
                                            color: item.is_success ? Theme.status_green : Theme.status_red;
                                            vertical_alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: item.source_name;
                                                font_size: 13px;
                                                font_weight: 600;
                                                color: #f1f5f9;
                                            }
                                            Text {
                                                text: item.output_path;
                                                font_size: 11px;
                                                color: #94a3b8;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: end;

                                        Rectangle {
                                            height: 22px;
                                            border_radius: 4px;
                                            background: #1e293b;
                                            HorizontalLayout {
                                                padding_left: 6px;
                                                padding_right: 6px;
                                                Text {
                                                    text: item.source_ext + " → " + item.target_ext;
                                                    font_size: 10px;
                                                    font_weight: 700;
                                                    color: #60a5fa;
                                                    vertical_alignment: center;
                                                }
                                            }
                                        }

                                        Button {
                                            text: "Open";
                                            clicked => { root.open_output_file(item.output_path); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // PAGE 3: FOLDERS
                if root.selected_nav == 3: VerticalLayout {
                    spacing: 16px;

                    Rectangle {
                        border_radius: 12px;
                        background: Theme.bg_card;
                        border_width: 1px;
                        border_color: Theme.border_subtle;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Managed Directories";
                                    font_size: 16px;
                                    font_weight: 700;
                                    color: #ffffff;
                                }
                                Button {
                                    text: "+ Add Directory";
                                    primary: true;
                                    clicked => { root.add_folder_clicked(); }
                                }
                            }

                            for folder in root.folders: Rectangle {
                                height: 56px;
                                border_radius: 8px;
                                background: #161922;
                                border_width: 1px;
                                border_color: #232736;

                                HorizontalLayout {
                                    padding_left: 16px;
                                    padding_right: 16px;
                                    spacing: 12px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text {
                                            text: "📁";
                                            font_size: 18px;
                                            vertical_alignment: center;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: folder.name;
                                                font_size: 14px;
                                                font_weight: 600;
                                                color: #f1f5f9;
                                            }
                                            Text {
                                                text: folder.path;
                                                font_size: 11px;
                                                color: #94a3b8;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: end;

                                        Button {
                                            text: "Explore";
                                            clicked => { root.open_folder_path(folder.path); }
                                        }

                                        Button {
                                            text: "Remove";
                                            clicked => { root.remove_folder(folder.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // PAGE 4: PRESETS
                if root.selected_nav == 4: VerticalLayout {
                    spacing: 16px;

                    Rectangle {
                        border_radius: 12px;
                        background: Theme.bg_card;
                        border_width: 1px;
                        border_color: Theme.border_subtle;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;

                            Text {
                                text: "Conversion Recipes & Presets";
                                font_size: 16px;
                                font_weight: 700;
                                color: #ffffff;
                            }

                            for preset in root.presets: Rectangle {
                                height: 68px;
                                border_radius: 8px;
                                background: #161922;
                                border_width: 1px;
                                border_color: #232736;

                                HorizontalLayout {
                                    padding_left: 16px;
                                    padding_right: 16px;
                                    spacing: 12px;
                                    alignment: space-between;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        Text {
                                            text: preset.name + " (" + preset.target_format + ")";
                                            font_size: 14px;
                                            font_weight: 700;
                                            color: #f1f5f9;
                                        }
                                        Text {
                                            text: preset.desc;
                                            font_size: 11px;
                                            color: #94a3b8;
                                        }
                                    }

                                    Button {
                                        text: "Apply to Convert Studio";
                                        primary: true;
                                        clicked => { root.apply_preset_clicked(preset.id); }
                                    }
                                }
                            }
                        }
                    }
                }

                // PAGE 5: SETTINGS
                if root.selected_nav == 5: VerticalLayout {
                    spacing: 20px;

                    Rectangle {
                        border_radius: 12px;
                        background: Theme.bg_card;
                        border_width: 1px;
                        border_color: Theme.border_subtle;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;

                            Text {
                                text: "General Preferences";
                                font_size: 16px;
                                font_weight: 700;
                                color: #ffffff;
                            }

                            CheckBox {
                                text: "Show desktop balloon notifications on conversion completion";
                                checked: root.show_notifications;
                                toggled => { root.show_notifications = self.checked; }
                            }

                            CheckBox {
                                text: "Minimize to system tray instead of closing";
                                checked: root.minimize_to_tray;
                                toggled => { root.minimize_to_tray = self.checked; }
                            }

                            CheckBox {
                                text: "Launch OrbitConvert on Windows startup";
                                checked: root.launch_on_startup;
                                toggled => { root.launch_on_startup = self.checked; }
                            }
                        }
                    }

                    Rectangle {
                        border_radius: 12px;
                        background: Theme.bg_card;
                        border_width: 1px;
                        border_color: Theme.border_subtle;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;

                            Text {
                                text: "Image & Vector Tuning";
                                font_size: 16px;
                                font_weight: 700;
                                color: #ffffff;
                            }

                            VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Default JPEG Quality:";
                                        font_size: 13px;
                                        color: Theme.text_secondary;
                                    }
                                    Text {
                                        text: root.jpeg_quality + "%";
                                        font_size: 13px;
                                        font_weight: 700;
                                        color: #60a5fa;
                                    }
                                }
                                Slider {
                                    minimum: 50;
                                    maximum: 100;
                                    value: root.jpeg_quality;
                                    changed(val) => { root.jpeg_quality = Math.round(val); }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Default SVG Raster Scale:";
                                        font_size: 13px;
                                        color: Theme.text_secondary;
                                    }
                                    Text {
                                        text: root.svg_scale + "x";
                                        font_size: 13px;
                                        font_weight: 700;
                                        color: #60a5fa;
                                    }
                                }
                                Slider {
                                    minimum: 1.0;
                                    maximum: 4.0;
                                    value: root.svg_scale;
                                    changed(val) => { root.svg_scale = Math.round(val * 10) / 10; }
                                }
                            }

                            Button {
                                text: "💾 Save Preferences";
                                primary: true;
                                clicked => { root.save_settings_clicked(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
