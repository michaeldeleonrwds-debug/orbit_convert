import { Theme } from "theme.slint";
import { RadialWheel, WheelSector } from "wheel.slint";
import { AppButton, SecondaryButton, DangerButton, StatusBadge, Card, AppSlider, AppCheckBox, SearchInput } from "components.slint";

export { RadialWheel, WheelSector }

export struct FolderItem {
    id: string,
    name: string,
    path: string,
    enabled: bool,
    is_watched: bool,
}

export struct HistoryItem {
    id: int,
    source_name: string,
    source_ext: string,
    target_ext: string,
    output_path: string,
    output_size_str: string,
    duration_ms: int,
    is_success: bool,
    status_text: string,
}

export struct PresetItem {
    id: string,
    name: string,
    desc: string,
    target_format: string,
    quality: int,
    svg_scale: float,
}

export struct FormatCapabilityItem {
    name: string,
    extension: string,
    category: string,
    can_decode: bool,
    can_encode: bool,
    engine: string,
    status_label: string,
    status_color: color,
    tested_status: string,
    limitations: string,
}

export component MainWindow inherits Window {
    title: "OrbitConvert — Fast, Powerful File Conversion";
    icon: @image-url("../../../assets/app_icon.png");
    min_width: 1100px;
    min_height: 700px;
    preferred_width: 1360px;
    preferred_height: 860px;
    background: #0d0f17;

    // Navigation state: 0=Dashboard, 1=Convert, 2=History, 3=Folders, 4=Presets, 5=Settings, 6=Diagnostics
    in-out property <int> selected_nav: 0;

    // Dashboard & Settings state
    in-out property <string> shortcut_label: "Hold Alt";
    in-out property <string> output_folder_label: "Same as source file";
    in-out property <int> jpeg_quality: 90;
    in-out property <float> svg_scale: 1.0;
    in-out property <bool> show_notifications: true;
    in-out property <bool> launch_on_startup: false;
    in-out property <bool> minimize_to_tray: true;
    in-out property <bool> service_active: true;
    in-out property <string> output_mode: "source";
    in-out property <float> wheel_diameter: 340.0;
    in-out property <float> dead_zone: 72.5;

    // Diagnostics State
    in-out property <string> diag_window_class: "N/A";
    in-out property <string> diag_element_name: "None";
    in-out property <string> diag_resolved_path: "None";
    in-out property <string> diag_detected_format: "None";
    in-out property <string> diag_status: "Ready";
    in-out property <bool> diag_ffmpeg_installed: true;

    in-out property <[FolderItem]> folders: [];
    in-out property <[HistoryItem]> history: [];
    in-out property <[PresetItem]> presets: [];
    in-out property <[FormatCapabilityItem]> capability_matrix: [];
    in-out property <bool> show_all_formats_modal: false;
    in-out property <string> format_search_filter: "";
    in-out property <string> format_active_category: "ALL";

    // Manual Convert Page State
    in-out property <string> convert_source_path: "";
    in-out property <string> convert_source_name: "No file selected";
    in-out property <string> convert_source_ext: "NONE";
    in-out property <string> convert_target_fmt: "PNG";
    in-out property <float> convert_progress: 0.0;
    in-out property <bool> is_converting: false;
    in-out property <string> convert_status_msg: "Ready to convert";
    in-out property <string> convert_last_output: "";

    // Callbacks
    callback nav_clicked(int);
    callback add_folder_clicked();
    callback toggle_folder(string, bool);
    callback remove_folder(string);
    callback open_folder_path(string);
    callback browse_file_clicked();
    callback select_target_format(string);
    callback start_manual_conversion();
    callback open_output_file(string);
    callback clear_history_clicked();
    callback apply_preset_clicked(string);
    callback save_settings_clicked();
    callback run_diagnostics_clicked();
    callback choose_custom_output_clicked();
    callback toggle_service_clicked();
    callback preview_wheel_clicked();
    callback open_all_formats_dialog();
    callback select_target_format_from_picker(string);
    callback format_search_changed(string);
    callback cancel_conversion();
    callback retry_conversion(int);

    HorizontalLayout {
        // ==================== SIDEBAR ====================
        Rectangle {
            width: 250px;
            background: #10131d;
            border_width: 1px;
            border_color: #1a202c;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                // Brand Header
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    vertical-stretch: 0;

                    Image {
                        source: @image-url("../../../assets/app_icon.png");
                        width: 36px;
                        height: 36px;
                        image-fit: contain;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: "OrbitConvert";
                            font_size: 16px;
                            font_weight: 800;
                            color: #FFFFFF;
                        }

                        Text {
                            text: "UNIVERSAL FILE CONVERTER";
                            font_size: 8px;
                            font_weight: 700;
                            color: #64748B;
                            letter_spacing: 0.6px;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #1a202c;
                    vertical-stretch: 0;
                }

                // Navigation Items
                VerticalLayout {
                    spacing: 4px;
                    alignment: start;
                    vertical-stretch: 0;

                    // 0: Dashboard
                    Rectangle {
                        height: 38px;
                        border_radius: 6px;
                        background: root.selected_nav == 0 ? #1e2638 : transparent;
                        border_width: root.selected_nav == 0 ? 1px : 0px;
                        border_color: #2b364e;

                        TouchArea { clicked => { root.selected_nav = 0; root.nav_clicked(0); } }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "📊";
                                font_size: 14px;
                                vertical_alignment: center;
                            }
                            Text {
                                text: "Dashboard";
                                font_size: 13px;
                                font_weight: root.selected_nav == 0 ? 700 : 500;
                                color: root.selected_nav == 0 ? #FFFFFF : #C8CDD7;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // 1: Convert
                    Rectangle {
                        height: 38px;
                        border_radius: 6px;
                        background: root.selected_nav == 1 ? #1e2638 : transparent;
                        border_width: root.selected_nav == 1 ? 1px : 0px;
                        border_color: #2b364e;

                        TouchArea { clicked => { root.selected_nav = 1; root.nav_clicked(1); } }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "🔄";
                                font_size: 14px;
                                vertical_alignment: center;
                            }
                            Text {
                                text: "Convert Studio";
                                font_size: 13px;
                                font_weight: root.selected_nav == 1 ? 700 : 500;
                                color: root.selected_nav == 1 ? #FFFFFF : #C8CDD7;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // 2: History
                    Rectangle {
                        height: 38px;
                        border_radius: 6px;
                        background: root.selected_nav == 2 ? #1e2638 : transparent;
                        border_width: root.selected_nav == 2 ? 1px : 0px;
                        border_color: #2b364e;

                        TouchArea { clicked => { root.selected_nav = 2; root.nav_clicked(2); } }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "🕒";
                                font_size: 14px;
                                vertical_alignment: center;
                            }
                            Text {
                                text: "History";
                                font_size: 13px;
                                font_weight: root.selected_nav == 2 ? 700 : 500;
                                color: root.selected_nav == 2 ? #FFFFFF : #C8CDD7;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // 3: Folders
                    Rectangle {
                        height: 38px;
                        border_radius: 6px;
                        background: root.selected_nav == 3 ? #1e2638 : transparent;
                        border_width: root.selected_nav == 3 ? 1px : 0px;
                        border_color: #2b364e;

                        TouchArea { clicked => { root.selected_nav = 3; root.nav_clicked(3); } }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "📁";
                                font_size: 12px;
                                color: root.selected_nav == 3 ? #248BFF : #8C96A8;
                                vertical_alignment: center;
                            }
                            Text {
                                text: "Managed Folders";
                                font_size: 13px;
                                font_weight: root.selected_nav == 3 ? 700 : 500;
                                color: root.selected_nav == 3 ? #FFFFFF : #C8CDD7;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // 4: Presets
                    Rectangle {
                        height: 38px;
                        border_radius: 6px;
                        background: root.selected_nav == 4 ? #1e2638 : transparent;
                        border_width: root.selected_nav == 4 ? 1px : 0px;
                        border_color: #2b364e;

                        TouchArea { clicked => { root.selected_nav = 4; root.nav_clicked(4); } }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "⚡";
                                font_size: 13px;
                                color: root.selected_nav == 4 ? #248BFF : #8C96A8;
                                vertical_alignment: center;
                            }
                            Text {
                                text: "Presets";
                                font_size: 13px;
                                font_weight: root.selected_nav == 4 ? 700 : 500;
                                color: root.selected_nav == 4 ? #FFFFFF : #C8CDD7;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // 5: Settings
                    Rectangle {
                        height: 38px;
                        border_radius: 6px;
                        background: root.selected_nav == 5 ? #1e2638 : transparent;
                        border_width: root.selected_nav == 5 ? 1px : 0px;
                        border_color: #2b364e;

                        TouchArea { clicked => { root.selected_nav = 5; root.nav_clicked(5); } }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "⚙";
                                font_size: 14px;
                                color: root.selected_nav == 5 ? #248BFF : #8C96A8;
                                vertical_alignment: center;
                            }
                            Text {
                                text: "Settings";
                                font_size: 13px;
                                font_weight: root.selected_nav == 5 ? 700 : 500;
                                color: root.selected_nav == 5 ? #FFFFFF : #C8CDD7;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // 6: Diagnostics
                    Rectangle {
                        height: 38px;
                        border_radius: 6px;
                        background: root.selected_nav == 6 ? #1e2638 : transparent;
                        border_width: root.selected_nav == 6 ? 1px : 0px;
                        border_color: #2b364e;

                        TouchArea { clicked => { root.selected_nav = 6; root.nav_clicked(6); } }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "🔍";
                                font_size: 12px;
                                color: root.selected_nav == 6 ? #248BFF : #8C96A8;
                                vertical_alignment: center;
                            }
                            Text {
                                text: "Diagnostics";
                                font_size: 13px;
                                font_weight: root.selected_nav == 6 ? 700 : 500;
                                color: root.selected_nav == 6 ? #FFFFFF : #C8CDD7;
                                vertical_alignment: center;
                            }
                        }
                    }
                }

                // Vertical Spacer
                Rectangle { vertical-stretch: 1; }

                // Sidebar Footer: Service Status & Wheel Preview Button
                VerticalLayout {
                    spacing: 10px;
                    alignment: start;
                    vertical-stretch: 0;

                    AppButton {
                        text: "Preview Radial Wheel";
                        icon_text: "◎";
                        is_primary: false;
                        clicked => { root.preview_wheel_clicked(); }
                    }

                    Rectangle {
                        height: 52px;
                        border_radius: 6px;
                        background: #141824;
                        border_width: 1px;
                        border_color: #1e2436;

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 10px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: "Explorer Hook";
                                    font_size: 12px;
                                    font_weight: 600;
                                    color: #FFFFFF;
                                    vertical_alignment: center;
                                }
                                Text {
                                    text: root.service_active ? "Hold Alt to Convert" : "Service Paused";
                                    font_size: 10px;
                                    color: root.service_active ? #10B981 : #EF4444;
                                    vertical_alignment: center;
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border_radius: 11px;
                                    background: root.service_active ? #10B98120 : #EF444420;
                                    border_width: 1.5px;
                                    border_color: root.service_active ? #10B981 : #EF4444;

                                    TouchArea { clicked => { root.toggle_service_clicked(); } }

                                    Rectangle {
                                        x: 7px;
                                        y: 7px;
                                        width: 8px;
                                        height: 8px;
                                        border_radius: 4px;
                                        background: root.service_active ? #10B981 : #EF4444;
                                    }
                                }
                            }
                        }
                    }

                    // App Versioning, Developer & License Card
                    Rectangle {
                        border_radius: 6px;
                        background: #0d1017;
                        border_width: 1px;
                        border_color: #1a202c;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            alignment: center;

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "OrbitConvert"; font_size: 11px; font_weight: 700; color: #FFFFFF; vertical_alignment: center; }
                                StatusBadge { text: "v0.1.0"; badge_color: #248BFF20; text_color: #38BDF8; }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text { text: "Dev:"; font_size: 10px; color: #64748B; vertical_alignment: center; }
                                Text { text: "Michael De Leon"; font_size: 10px; font_weight: 600; color: #CBD5E1; vertical_alignment: center; }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text { text: "License:"; font_size: 10px; color: #64748B; vertical_alignment: center; }
                                Text { text: "MIT / Apache-2.0"; font_size: 10px; font_weight: 600; color: #10B981; vertical_alignment: center; }
                            }
                        }
                    }
                }
            }
        }

        // ==================== MAIN CONTENT AREA ====================
        VerticalLayout {
            // Header Bar
            Rectangle {
                height: 64px;
                background: #10131d;
                border_width: 1px;
                border_color: #1a202c;
                vertical-stretch: 0;

                HorizontalLayout {
                    padding_left: 28px;
                    padding_right: 28px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: root.selected_nav == 0 ? "Dashboard" :
                                root.selected_nav == 1 ? "Convert Studio" :
                                root.selected_nav == 2 ? "Conversion History" :
                                root.selected_nav == 3 ? "Managed Folders" :
                                root.selected_nav == 4 ? "Conversion Presets" :
                                root.selected_nav == 5 ? "Application Settings" :
                                "Explorer Diagnostics";
                            font_size: 18px;
                            font_weight: 800;
                            color: #FFFFFF;
                        }

                        Text {
                            text: root.selected_nav == 0 ? "Universal file conversion with radial wheel integration" :
                                root.selected_nav == 1 ? "Convert any file manual workspace" :
                                root.selected_nav == 2 ? "Audit log of conversions" :
                                root.selected_nav == 3 ? "Monitored directories for instant access" :
                                root.selected_nav == 4 ? "One-click conversion profiles" :
                                root.selected_nav == 5 ? "Configure shortcuts, output paths, and engines" :
                                "Inspect Explorer hit-testing and pipeline resolution";
                            font_size: 11px;
                            color: #8C96A8;
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        HorizontalLayout {
                            spacing: 12px;

                            if root.is_converting: Rectangle {
                                height: 36px;
                                border_radius: 18px;
                                background: #141f36;
                                border_width: 1px;
                                border_color: #248BFF;

                                HorizontalLayout {
                                    padding_left: 14px;
                                    padding_right: 14px;
                                    spacing: 8px;
                                    alignment: center;

                                    Text {
                                        text: "⚡";
                                        font_size: 13px;
                                        vertical_alignment: center;
                                    }
                                    Text {
                                        text: root.convert_status_msg;
                                        font_size: 12px;
                                        font_weight: 700;
                                        color: #60A5FA;
                                        vertical_alignment: center;
                                    }
                                }
                            }

                            SecondaryButton {
                                text: "Command Palette";
                                icon_text: "⚡";
                                clicked => { root.show_all_formats_modal = true; root.open_all_formats_dialog(); }
                            }

                            SecondaryButton {
                                text: "Run Diagnostics";
                                icon_text: "🔍";
                                clicked => { root.run_diagnostics_clicked(); }
                            }

                            AppButton {
                                text: "Convert File";
                                icon_text: "+";
                                is_primary: true;
                                clicked => { root.selected_nav = 1; root.browse_file_clicked(); }
                            }
                        }
                    }
                }
            }

            // Scrollable Content View
            Rectangle {
                background: #0d0f17;

                // PAGE 0: DASHBOARD
                if root.selected_nav == 0: VerticalLayout {
                    padding: 28px;
                    spacing: 24px;
                    alignment: start;

                    // Live Conversion Progress Banner
                    if root.is_converting: Rectangle {
                        height: 64px;
                        border_radius: 8px;
                        background: #141c2e;
                        border_width: 1px;
                        border_color: #248BFF;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            alignment: center;

                            HorizontalLayout {
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "⚡"; font_size: 14px; vertical_alignment: center; }
                                    Text {
                                        text: root.convert_status_msg;
                                        font_size: 13px;
                                        font_weight: 700;
                                        color: #60A5FA;
                                        vertical_alignment: center;
                                    }
                                }
                                Text {
                                    text: Math.round(root.convert_progress * 100.0) + "%";
                                    font_size: 13px;
                                    font_weight: 800;
                                    color: #38BDF8;
                                    vertical_alignment: center;
                                }
                            }

                            Rectangle {
                                height: 5px;
                                border_radius: 2.5px;
                                background: #1e293b;
                                clip: true;

                                Rectangle {
                                    x: 0;
                                    width: parent.width * root.convert_progress;
                                    height: 100%;
                                    border_radius: 2.5px;
                                    background: #248BFF;
                                }
                            }
                        }
                    }

                    // Category Cards Grid
                    VerticalLayout {
                        spacing: 12px;
                        alignment: start;
                        vertical-stretch: 0;

                        Text {
                            text: "SUPPORTED CONVERSION FORMATS";
                            font_size: 11px;
                            font_weight: 700;
                            color: #64748B;
                            letter_spacing: 0.8px;
                        }

                        HorizontalLayout {
                            spacing: 14px;
                            vertical-stretch: 0;

                            // Images Card
                            Rectangle {
                                height: 110px;
                                border_radius: 8px;
                                background: #141824;
                                border_width: 1px;
                                border_color: #1e2638;

                                VerticalLayout {
                                    padding: 16px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "🖼 Images"; font_size: 14px; font_weight: 700; color: #FFFFFF; }
                                        StatusBadge { text: "READY"; badge_color: #248BFF20; text_color: #38BDF8; }
                                    }
                                    Text {
                                        text: "SVG, PNG, JPG, WebP, ICO, BMP, TIFF, GIF";
                                        font_size: 11px;
                                        color: #8C96A8;
                                    }
                                }
                            }

                            // Video Card
                            Rectangle {
                                height: 110px;
                                border_radius: 8px;
                                background: #141824;
                                border_width: 1px;
                                border_color: #1e2638;

                                VerticalLayout {
                                    padding: 16px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "🎬 Video"; font_size: 14px; font_weight: 700; color: #FFFFFF; }
                                        StatusBadge { text: "FFMPEG"; badge_color: #10B98120; text_color: #10B981; }
                                    }
                                    Text {
                                        text: "MP4, MOV, MKV, AVI, WebM → Audio Extraction";
                                        font_size: 11px;
                                        color: #8C96A8;
                                    }
                                }
                            }

                            // Audio Card
                            Rectangle {
                                height: 110px;
                                border_radius: 8px;
                                background: #141824;
                                border_width: 1px;
                                border_color: #1e2638;

                                VerticalLayout {
                                    padding: 16px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "🎵 Audio"; font_size: 14px; font_weight: 700; color: #FFFFFF; }
                                        StatusBadge { text: "READY"; badge_color: #10B98120; text_color: #10B981; }
                                    }
                                    Text {
                                        text: "MP3, WAV, FLAC, AAC, M4A, OGG Transcoding";
                                        font_size: 11px;
                                        color: #8C96A8;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 14px;
                            vertical-stretch: 0;

                            // Spreadsheets & Data Card
                            Rectangle {
                                height: 110px;
                                border_radius: 8px;
                                background: #141824;
                                border_width: 1px;
                                border_color: #1e2638;

                                VerticalLayout {
                                    padding: 16px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "📊 Spreadsheets & Data"; font_size: 14px; font_weight: 700; color: #FFFFFF; }
                                        StatusBadge { text: "READY"; badge_color: #10B98120; text_color: #10B981; }
                                    }
                                    Text {
                                        text: "CSV ↔ JSON, CSV ↔ TSV Tabular Transformations";
                                        font_size: 11px;
                                        color: #8C96A8;
                                    }
                                }
                            }

                            // Documents Card
                            Rectangle {
                                height: 110px;
                                border_radius: 8px;
                                background: #141824;
                                border_width: 1px;
                                border_color: #1e2638;

                                VerticalLayout {
                                    padding: 16px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "📄 Documents"; font_size: 14px; font_weight: 700; color: #FFFFFF; }
                                        StatusBadge { text: "STANDALONE"; badge_color: #F59E0B20; text_color: #F59E0B; }
                                    }
                                    Text {
                                        text: "PDF, TXT, HTML & Office Formats";
                                        font_size: 11px;
                                        color: #8C96A8;
                                    }
                                }
                            }

                            // Radial Wheel Card
                            Rectangle {
                                height: 110px;
                                border_radius: 8px;
                                background: #141824;
                                border_width: 1px;
                                border_color: #1e2638;

                                VerticalLayout {
                                    padding: 16px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "◎ Radial Wheel"; font_size: 14px; font_weight: 700; color: #FFFFFF; }
                                        StatusBadge { text: "ACTIVE"; badge_color: #248BFF20; text_color: #38BDF8; }
                                    }
                                    Text {
                                        text: "Hover file in Explorer + Hold Alt to Trigger";
                                        font_size: 11px;
                                        color: #8C96A8;
                                    }
                                }
                            }
                        }
                    }

                    // Lower Panels: Managed Folders & Quick Settings
                    HorizontalLayout {
                        spacing: 20px;
                        vertical-stretch: 0;

                        // Folders Preview
                        Rectangle {
                            border_radius: 8px;
                            background: #141824;
                            border_width: 1px;
                            border_color: #1e2638;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 14px;
                                    vertical-stretch: 0;

                                    VerticalLayout {
                                        alignment: center;
                                        Text { text: "Managed Folders"; font_size: 14px; font_weight: 700; color: #FFFFFF; vertical_alignment: center; }
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    VerticalLayout {
                                        alignment: center;
                                        AppButton {
                                            text: "+ Add Folder";
                                            is_primary: true;
                                            clicked => { root.add_folder_clicked(); }
                                        }
                                    }
                                }

                                if root.folders.length == 0: Rectangle {
                                    height: 100px;
                                    border_radius: 6px;
                                    background: #0d1017;
                                    border_width: 1px;
                                    border_color: #1a202c;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text { text: "No folders added yet"; font_size: 12px; color: #8C96A8; horizontal_alignment: center; }
                                        Text { text: "Add folders for quick access and monitored conversions"; font_size: 10px; color: #475569; horizontal_alignment: center; }
                                    }
                                }

                                for folder in root.folders: Rectangle {
                                    height: 52px;
                                    border_radius: 6px;
                                    background: #0d1017;
                                    border_width: 1px;
                                    border_color: #1a202c;
                                    vertical-stretch: 0;

                                    HorizontalLayout {
                                        padding_left: 14px;
                                        padding_right: 14px;
                                        spacing: 14px;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: folder.name; font_size: 12px; font_weight: 600; color: #FFFFFF; vertical_alignment: center; }
                                            Text { text: folder.path; font_size: 10px; color: #64748B; overflow: elide; vertical_alignment: center; }
                                        }

                                        Rectangle { horizontal-stretch: 1; }

                                        VerticalLayout {
                                            alignment: center;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                SecondaryButton {
                                                    text: "Open";
                                                    clicked => { root.open_folder_path(folder.path); }
                                                }
                                                DangerButton {
                                                    text: "✕";
                                                    clicked => { root.remove_folder(folder.id); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Quick Settings
                        Rectangle {
                            width: 380px;
                            border_radius: 8px;
                            background: #141824;
                            border_width: 1px;
                            border_color: #1e2638;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;
                                alignment: start;

                                Text { text: "Quick Conversion Settings"; font_size: 14px; font_weight: 700; color: #FFFFFF; vertical-stretch: 0; }

                                VerticalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    vertical-stretch: 0;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "JPEG Output Quality: " + root.jpeg_quality + "%"; font_size: 12px; color: #C8CDD7; }
                                    }
                                    AppSlider {
                                        value: root.jpeg_quality;
                                        minimum: 20;
                                        maximum: 100;
                                        changed(val) => { root.jpeg_quality = Math.round(val); }
                                    }

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "SVG Rasterization Scale: " + Math.round(root.svg_scale * 10.0) / 10.0 + "x"; font_size: 12px; color: #C8CDD7; }
                                    }
                                    AppSlider {
                                        value: root.svg_scale;
                                        minimum: 0.5;
                                        maximum: 4.0;
                                        changed(val) => { root.svg_scale = val; }
                                    }

                                    AppCheckBox {
                                        text: "Show Windows desktop completion notifications";
                                        checked: root.show_notifications;
                                        toggled(val) => { root.show_notifications = val; }
                                    }

                                    AppButton {
                                        text: "Save Preferences";
                                        is_primary: true;
                                        clicked => { root.save_settings_clicked(); }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                // PAGE 1: CONVERT STUDIO
                if root.selected_nav == 1: VerticalLayout {
                    padding: 28px;
                    spacing: 20px;
                    alignment: start;

                    Rectangle {
                        border_radius: 8px;
                        background: #141824;
                        border_width: 1px;
                        border_color: #1e2638;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;
                            alignment: start;

                            Text { text: "MANUAL CONVERSION WORKSPACE"; font_size: 11px; font_weight: 700; color: #64748B; letter_spacing: 0.8px; }

                            HorizontalLayout {
                                spacing: 14px;
                                alignment: start;
                                vertical-stretch: 0;

                                AppButton {
                                    text: "Browse Source File...";
                                    icon_text: "📁";
                                    is_primary: true;
                                    clicked => { root.browse_file_clicked(); }
                                }

                                if root.convert_source_path != "": SecondaryButton {
                                    text: "Open File Location";
                                    clicked => { root.open_folder_path(root.convert_source_path); }
                                }
                            }

                            // File Info Panel
                            Rectangle {
                                height: 74px;
                                border_radius: 6px;
                                background: #0d1017;
                                border_width: 1px;
                                border_color: #1a202c;

                                HorizontalLayout {
                                    padding_left: 18px;
                                    padding_right: 18px;
                                    spacing: 16px;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text { text: root.convert_source_name; font_size: 14px; font_weight: 700; color: #FFFFFF; vertical_alignment: center; }
                                        Text { text: root.convert_source_path != "" ? root.convert_source_path : "No file loaded. Click 'Browse Source File' to select a file."; font_size: 11px; color: #64748B; vertical_alignment: center; }
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    VerticalLayout {
                                        alignment: center;
                                        StatusBadge {
                                            text: root.convert_source_ext;
                                            badge_color: #248BFF20;
                                            text_color: #38BDF8;
                                        }
                                    }
                                }
                            }

                            // Target Format Selectors
                            VerticalLayout {
                                spacing: 8px;
                                alignment: start;
                                vertical-stretch: 0;

                                Text { text: "Select Output Format:"; font_size: 12px; font_weight: 600; color: #C8CDD7; }

                                HorizontalLayout {
                                    spacing: 8px;
                                    vertical-stretch: 0;

                                    for fmt in ["PNG", "JPG", "WEBP", "ICO", "TIFF", "BMP", "GIF", "TGA", "MP3", "WAV", "MP4", "CSV", "PDF"]: Rectangle {
                                        height: 32px;
                                        border_radius: 6px;
                                        background: root.convert_target_fmt == fmt ? #248BFF : #1a202c;
                                        border_width: 1px;
                                        border_color: root.convert_target_fmt == fmt ? #3B9EFF : #283344;

                                        TouchArea { clicked => { root.convert_target_fmt = fmt; root.select_target_format(fmt); } }

                                        HorizontalLayout {
                                            padding_left: 10px;
                                            padding_right: 10px;
                                            alignment: center;
                                            Text {
                                                text: fmt;
                                                font_size: 11px;
                                                font_weight: 700;
                                                color: root.convert_target_fmt == fmt ? #FFFFFF : #94A3B8;
                                                vertical_alignment: center;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: 32px;
                                        border_radius: 6px;
                                        background: #1e293b;
                                        border_width: 1px;
                                        border_color: #38bdf8;

                                        TouchArea { clicked => { root.show_all_formats_modal = true; root.open_all_formats_dialog(); } }

                                        HorizontalLayout {
                                            padding_left: 12px;
                                            padding_right: 12px;
                                            spacing: 6px;
                                            alignment: center;
                                            Text {
                                                text: "🔍 All Formats (60+)...";
                                                font_size: 11px;
                                                font_weight: 700;
                                                color: #38bdf8;
                                                vertical_alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // Convert Action & Progress
                            VerticalLayout {
                                spacing: 12px;
                                alignment: start;
                                vertical-stretch: 0;

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;

                                    AppButton {
                                        text: root.is_converting ? "Converting..." : "Convert File";
                                        icon_text: "⚡";
                                        enabled: root.convert_source_path != "" && !root.is_converting;
                                        is_primary: true;
                                        clicked => { root.start_manual_conversion(); }
                                    }

                                    if root.is_converting: DangerButton {
                                        text: "✕ Cancel";
                                        clicked => { root.cancel_conversion(); }
                                    }

                                    if root.convert_last_output != "" && !root.is_converting: AppButton {
                                        text: "Open Converted File";
                                        icon_text: "↗";
                                        is_primary: false;
                                        clicked => { root.open_output_file(root.convert_last_output); }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    width: 100%;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        width: 100%;
                                        Text {
                                            text: root.convert_status_msg;
                                            font_size: 13px;
                                            font_weight: 600;
                                            color: root.is_converting ? #38BDF8 : (root.convert_last_output != "" ? #10B981 : #8C96A8);
                                        }
                                        if root.is_converting: Text {
                                            text: Math.round(root.convert_progress * 100.0) + "%";
                                            font_size: 13px;
                                            font_weight: 700;
                                            color: #38BDF8;
                                        }
                                    }

                                    if root.is_converting: Rectangle {
                                        height: 6px;
                                        width: 100%;
                                        border_radius: 3px;
                                        background: #1e293b;
                                        clip: true;

                                        Rectangle {
                                            x: 0;
                                            width: parent.width * root.convert_progress;
                                            height: 100%;
                                            border_radius: 3px;
                                            background: #248BFF;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                // PAGE 2: HISTORY
                if root.selected_nav == 2: VerticalLayout {
                    padding: 28px;
                    spacing: 16px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 16px;
                        vertical-stretch: 0;

                        VerticalLayout {
                            alignment: center;
                            Text { text: "CONVERSION AUDIT LOG"; font_size: 11px; font_weight: 700; color: #64748B; letter_spacing: 0.8px; vertical_alignment: center; }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        VerticalLayout {
                            alignment: center;
                            SecondaryButton {
                                text: "Clear History";
                                icon_text: "🗑";
                                clicked => { root.clear_history_clicked(); }
                            }
                        }
                    }

                    if root.history.length == 0: Rectangle {
                        height: 160px;
                        border_radius: 8px;
                        background: #141824;
                        border_width: 1px;
                        border_color: #1e2638;

                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text { text: "No conversion history recorded yet"; font_size: 14px; font_weight: 600; color: #FFFFFF; horizontal_alignment: center; }
                            Text { text: "Trigger conversions using the radial wheel in Explorer or Convert Studio"; font_size: 11px; color: #64748B; horizontal_alignment: center; }
                        }
                    }

                    for item in root.history: Rectangle {
                        height: 52px;
                        border_radius: 6px;
                        background: #141824;
                        border_width: 1px;
                        border_color: #1e2638;
                        vertical-stretch: 0;

                        HorizontalLayout {
                            padding_left: 16px;
                            padding_right: 16px;
                            spacing: 16px;

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: start;

                                    Text { text: item.source_name; font_size: 13px; font_weight: 600; color: #FFFFFF; vertical_alignment: center; }
                                    VerticalLayout {
                                        alignment: center;
                                        StatusBadge {
                                            text: item.source_ext + " → " + item.target_ext;
                                            badge_color: item.is_success ? #10B98120 : #EF444420;
                                            text_color: item.is_success ? #10B981 : #EF4444;
                                        }
                                    }
                                    if item.output_size_str != "": Text {
                                        text: "• " + item.output_size_str;
                                        font_size: 11px;
                                        font_weight: 600;
                                        color: #38BDF8;
                                        vertical_alignment: center;
                                    }
                                    Text {
                                        text: item.status_text;
                                        font_size: 11px;
                                        color: item.is_success ? #8C96A8 : #EF4444;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        vertical_alignment: center;
                                    }
                                }
                            }

                            if !item.is_success: VerticalLayout {
                                alignment: center;
                                SecondaryButton {
                                    text: "↻ Retry";
                                    clicked => { root.retry_conversion(item.id); }
                                }
                            }

                            if item.output_path != "": VerticalLayout {
                                alignment: center;
                                SecondaryButton {
                                    text: "Locate in Explorer";
                                    clicked => { root.open_output_file(item.output_path); }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                // PAGE 3: FOLDERS
                if root.selected_nav == 3: VerticalLayout {
                    padding: 28px;
                    spacing: 16px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 16px;
                        vertical-stretch: 0;

                        VerticalLayout {
                            alignment: center;
                            Text { text: "MANAGED & WATCHED DIRECTORIES"; font_size: 11px; font_weight: 700; color: #64748B; letter_spacing: 0.8px; vertical_alignment: center; }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        VerticalLayout {
                            alignment: center;
                            AppButton {
                                text: "+ Add Folder";
                                is_primary: true;
                                clicked => { root.add_folder_clicked(); }
                            }
                        }
                    }

                    if root.folders.length == 0: Rectangle {
                        height: 160px;
                        border_radius: 8px;
                        background: #141824;
                        border_width: 1px;
                        border_color: #1e2638;

                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text { text: "No managed folders configured"; font_size: 14px; font_weight: 600; color: #FFFFFF; horizontal_alignment: center; }
                            Text { text: "Click '+ Add Folder' above to add directories for quick access"; font_size: 11px; color: #64748B; horizontal_alignment: center; }
                        }
                    }

                    for folder in root.folders: Rectangle {
                        height: 64px;
                        border_radius: 6px;
                        background: #141824;
                        border_width: 1px;
                        border_color: #1e2638;
                        vertical-stretch: 0;

                        HorizontalLayout {
                            padding_left: 18px;
                            padding_right: 18px;
                            spacing: 16px;

                            // Left Group (vertically centered)
                            VerticalLayout {
                                alignment: center;

                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: start;

                                    Text {
                                        text: "📁";
                                        font_size: 22px;
                                        vertical_alignment: center;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        Text {
                                            text: folder.name;
                                            font_size: 13px;
                                            font_weight: 700;
                                            color: #FFFFFF;
                                            vertical_alignment: center;
                                        }
                                        Text {
                                            text: folder.path;
                                            font_size: 11px;
                                            color: #8C96A8;
                                            overflow: elide;
                                            vertical_alignment: center;
                                        }
                                    }
                                }
                            }

                            // Flexible Spacer
                            Rectangle { horizontal-stretch: 1; }

                            // Right Group (vertically centered)
                            VerticalLayout {
                                alignment: center;

                                HorizontalLayout {
                                    spacing: 10px;

                                    SecondaryButton {
                                        text: "Open Explorer";
                                        clicked => { root.open_folder_path(folder.path); }
                                    }

                                    DangerButton {
                                        text: "Remove";
                                        clicked => { root.remove_folder(folder.id); }
                                    }
                                }
                            }
                        }
                    }

                    // Folder Automation Information Card
                    Rectangle {
                        border_radius: 8px;
                        background: #141824;
                        border_width: 1px;
                        border_color: #1e2638;
                        vertical-stretch: 0;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;

                            Text { text: "AUTOMATED DIRECTORY MONITORING"; font_size: 11px; font_weight: 700; color: #64748B; letter_spacing: 0.8px; }

                            HorizontalLayout {
                                spacing: 20px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text { text: "📁 Instant Explorer Access"; font_size: 13px; font_weight: 600; color: #FFFFFF; }
                                    Text { text: "Pin high-traffic directories for instant navigation. Files saved to monitored folders are immediately indexed for Alt-wheel conversion."; font_size: 11px; color: #8C96A8; wrap: word-wrap; }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text { text: "⚡ Rapid Batch Conversion"; font_size: 13px; font_weight: 600; color: #FFFFFF; }
                                    Text { text: "Right-click or hold Alt in any monitored folder to convert single or multiple files without manually choosing destination directories."; font_size: 11px; color: #8C96A8; wrap: word-wrap; }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                // PAGE 4: PRESETS
                if root.selected_nav == 4: VerticalLayout {
                    padding: 28px;
                    spacing: 16px;
                    alignment: start;

                    Text { text: "CONVERSION PRESETS"; font_size: 11px; font_weight: 700; color: #64748B; letter_spacing: 0.8px; }

                    for preset in root.presets: Rectangle {
                        height: 68px;
                        border_radius: 8px;
                        background: #141824;
                        border_width: 1px;
                        border_color: #1e2638;
                        vertical-stretch: 0;

                        HorizontalLayout {
                            padding_left: 20px;
                            padding_right: 20px;
                            spacing: 16px;

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                Text { text: preset.name; font_size: 14px; font_weight: 700; color: #FFFFFF; vertical_alignment: center; }
                                Text { text: preset.desc; font_size: 11px; color: #8C96A8; vertical_alignment: center; }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            VerticalLayout {
                                alignment: center;

                                HorizontalLayout {
                                    spacing: 12px;

                                    VerticalLayout {
                                        alignment: center;
                                        StatusBadge {
                                            text: preset.target_format + " (" + preset.quality + "%)";
                                            badge_color: #248BFF20;
                                            text_color: #38BDF8;
                                        }
                                    }

                                    AppButton {
                                        text: "Use Preset";
                                        is_primary: true;
                                        clicked => { root.apply_preset_clicked(preset.id); }
                                    }
                                }
                            }
                        }
                    }

                    // Presets Integration & Quick Tips Card
                    Rectangle {
                        border_radius: 8px;
                        background: #141824;
                        border_width: 1px;
                        border_color: #1e2638;
                        vertical-stretch: 0;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;

                            Text { text: "HOW PRESETS WORK"; font_size: 11px; font_weight: 700; color: #64748B; letter_spacing: 0.8px; }

                            HorizontalLayout {
                                spacing: 20px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text { text: "⚡ One-Click Workflows"; font_size: 13px; font_weight: 600; color: #FFFFFF; }
                                    Text { text: "Selecting a preset instantly tunes quality, rasterization DPI, background compositing, and target formats across the radial wheel and Convert Studio."; font_size: 11px; color: #8C96A8; wrap: word-wrap; }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text { text: "◎ Radial Wheel Defaults"; font_size: 13px; font_weight: 600; color: #FFFFFF; }
                                    Text { text: "When converting from Windows File Explorer via Alt-wheel, active preset profiles ensure your output files match your target specs automatically."; font_size: 11px; color: #8C96A8; wrap: word-wrap; }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                // PAGE 5: SETTINGS
                if root.selected_nav == 5: VerticalLayout {
                    padding: 28px;
                    spacing: 20px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 20px;
                        vertical-stretch: 0;

                        // Left Card: Radial Wheel Geometry & Preview
                        Rectangle {
                            border_radius: 8px;
                            background: #141824;
                            border_width: 1px;
                            border_color: #1e2638;

                            VerticalLayout {
                                padding: 22px;
                                spacing: 16px;
                                alignment: start;

                                Text { text: "RADIAL WHEEL & ACTIVATION"; font_size: 11px; font_weight: 700; color: #64748B; letter_spacing: 0.8px; }

                                VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Wheel Diameter"; font_size: 13px; font_weight: 600; color: #FFFFFF; }
                                        Text { text: Math.round(root.wheel_diameter) + "px"; font_size: 12px; font_weight: 700; color: #38BDF8; }
                                    }
                                    AppSlider {
                                        value: root.wheel_diameter;
                                        minimum: 280;
                                        maximum: 440;
                                        changed(val) => { root.wheel_diameter = val; }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Center Dead Zone Radius"; font_size: 13px; font_weight: 600; color: #FFFFFF; }
                                        Text { text: Math.round(root.dead_zone) + "px"; font_size: 12px; font_weight: 700; color: #38BDF8; }
                                    }
                                    AppSlider {
                                        value: root.dead_zone;
                                        minimum: 40;
                                        maximum: 100;
                                        changed(val) => { root.dead_zone = val; }
                                    }
                                }

                                Rectangle { height: 1px; background: #1a202c; vertical-stretch: 0; }

                                SecondaryButton {
                                    text: "Interactive Wheel Preview (Test Without Alt)";
                                    icon_text: "◎";
                                    clicked => { root.preview_wheel_clicked(); }
                                }
                            }
                        }

                        // Right Card: Quality Defaults & Scaling
                        Rectangle {
                            border_radius: 8px;
                            background: #141824;
                            border_width: 1px;
                            border_color: #1e2638;

                            VerticalLayout {
                                padding: 22px;
                                spacing: 16px;
                                alignment: start;

                                Text { text: "CONVERSION ENGINES & QUALITY"; font_size: 11px; font_weight: 700; color: #64748B; letter_spacing: 0.8px; }

                                VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Default JPEG Quality"; font_size: 13px; font_weight: 600; color: #FFFFFF; }
                                        Text { text: root.jpeg_quality + "%"; font_size: 12px; font_weight: 700; color: #38BDF8; }
                                    }
                                    AppSlider {
                                        value: root.jpeg_quality;
                                        minimum: 20;
                                        maximum: 100;
                                        changed(val) => { root.jpeg_quality = Math.round(val); }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "SVG Rasterization Scale"; font_size: 13px; font_weight: 600; color: #FFFFFF; }
                                        Text { text: Math.round(root.svg_scale * 10.0) / 10.0 + "x"; font_size: 12px; font_weight: 700; color: #38BDF8; }
                                    }
                                    AppSlider {
                                        value: root.svg_scale;
                                        minimum: 0.5;
                                        maximum: 4.0;
                                        changed(val) => { root.svg_scale = val; }
                                    }
                                }

                                Rectangle { height: 1px; background: #1a202c; vertical-stretch: 0; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "FFmpeg Media Engine Status"; font_size: 12px; color: #8C96A8; vertical_alignment: center; }
                                    StatusBadge {
                                        text: root.diag_ffmpeg_installed ? "ACTIVE (SYSTEM PATH)" : "MISSING";
                                        badge_color: root.diag_ffmpeg_installed ? #10B98120 : #EF444420;
                                        text_color: root.diag_ffmpeg_installed ? #10B981 : #EF4444;
                                    }
                                }
                            }
                        }
                    }

                    // Lower Card: System & Background Integration
                    Rectangle {
                        border_radius: 8px;
                        background: #141824;
                        border_width: 1px;
                        border_color: #1e2638;
                        vertical-stretch: 0;

                        VerticalLayout {
                            padding: 22px;
                            spacing: 16px;
                            alignment: start;

                            Text { text: "WINDOWS SYSTEM INTEGRATION"; font_size: 11px; font_weight: 700; color: #64748B; letter_spacing: 0.8px; }

                            VerticalLayout {
                                spacing: 14px;
                                alignment: start;

                                AppCheckBox {
                                    text: "Show Windows desktop completion notifications";
                                    checked: root.show_notifications;
                                    toggled(val) => { root.show_notifications = val; }
                                }

                                AppCheckBox {
                                    text: "Launch on Windows startup";
                                    checked: root.launch_on_startup;
                                    toggled(val) => { root.launch_on_startup = val; }
                                }

                                AppCheckBox {
                                    text: "Minimize to system tray on close";
                                    checked: root.minimize_to_tray;
                                    toggled(val) => { root.minimize_to_tray = val; }
                                }
                            }
                        }
                    }

                    // Application About & Credits Card
                    Rectangle {
                        border_radius: 8px;
                        background: #141824;
                        border_width: 1px;
                        border_color: #1e2638;
                        vertical-stretch: 0;

                        VerticalLayout {
                            padding: 22px;
                            spacing: 14px;
                            alignment: start;

                            Text { text: "ABOUT ORBITCONVERT"; font_size: 11px; font_weight: 700; color: #64748B; letter_spacing: 0.8px; }

                            HorizontalLayout {
                                spacing: 32px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text { text: "Application Version"; font_size: 11px; color: #64748B; }
                                    Text { text: "OrbitConvert Desktop v0.1.0 (x86_64 Windows)"; font_size: 13px; font_weight: 600; color: #FFFFFF; wrap: word-wrap; }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text { text: "Developer"; font_size: 11px; color: #64748B; }
                                    Text { text: "Michael De Leon"; font_size: 13px; font_weight: 600; color: #38BDF8; wrap: word-wrap; }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text { text: "Software License"; font_size: 11px; color: #64748B; }
                                    Text { text: "MIT License / Apache-2.0 Dual License"; font_size: 13px; font_weight: 600; color: #10B981; wrap: word-wrap; }
                                }
                            }
                        }
                    }

                    // Save Button Row
                    HorizontalLayout {
                        alignment: start;
                        spacing: 14px;
                        vertical-stretch: 0;

                        AppButton {
                            text: "Save All Preferences";
                            icon_text: "💾";
                            is_primary: true;
                            clicked => { root.save_settings_clicked(); }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                // PAGE 6: DIAGNOSTICS
                if root.selected_nav == 6: VerticalLayout {
                    padding: 28px;
                    spacing: 20px;
                    alignment: start;

                    Rectangle {
                        border_radius: 8px;
                        background: #141824;
                        border_width: 1px;
                        border_color: #1e2638;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 16px;
                                vertical-stretch: 0;

                                VerticalLayout {
                                    alignment: center;
                                    Text { text: "EXPLORER ACTIVATION & PIPELINE DIAGNOSTICS"; font_size: 11px; font_weight: 700; color: #64748B; letter_spacing: 0.8px; vertical_alignment: center; }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                VerticalLayout {
                                    alignment: center;
                                    AppButton {
                                        text: "Run Cursor Diagnostic Check";
                                        icon_text: "🔍";
                                        is_primary: true;
                                        clicked => { root.run_diagnostics_clicked(); }
                                    }
                                }
                            }

                            // Diagnostic status cards
                            VerticalLayout {
                                spacing: 10px;
                                alignment: start;
                                vertical-stretch: 0;

                                Rectangle {
                                    height: 48px;
                                    border_radius: 6px;
                                    background: #0d1017;
                                    border_width: 1px;
                                    border_color: #1a202c;

                                    HorizontalLayout {
                                        padding_left: 16px;
                                        padding_right: 16px;
                                        spacing: 16px;

                                        VerticalLayout {
                                            alignment: center;
                                            Text { text: "Low-Level Keyboard Hook"; font_size: 12px; font_weight: 600; color: #FFFFFF; vertical_alignment: center; }
                                        }

                                        Rectangle { horizontal-stretch: 1; }

                                        VerticalLayout {
                                            alignment: center;
                                            StatusBadge { text: "INSTALLED & ACTIVE"; badge_color: #10B98120; text_color: #10B981; }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 48px;
                                    border_radius: 6px;
                                    background: #0d1017;
                                    border_width: 1px;
                                    border_color: #1a202c;

                                    HorizontalLayout {
                                        padding_left: 16px;
                                        padding_right: 16px;
                                        spacing: 16px;

                                        VerticalLayout {
                                            alignment: center;
                                            Text { text: "FFmpeg Media Transcoding Engine"; font_size: 12px; font_weight: 600; color: #FFFFFF; vertical_alignment: center; }
                                        }

                                        Rectangle { horizontal-stretch: 1; }

                                        VerticalLayout {
                                            alignment: center;
                                            StatusBadge { text: root.diag_ffmpeg_installed ? "INSTALLED (v9.0.1)" : "NOT FOUND"; badge_color: root.diag_ffmpeg_installed ? #10B98120 : #EF444420; text_color: root.diag_ffmpeg_installed ? #10B981 : #EF4444; }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 48px;
                                    border_radius: 6px;
                                    background: #0d1017;
                                    border_width: 1px;
                                    border_color: #1a202c;

                                    HorizontalLayout {
                                        padding_left: 16px;
                                        padding_right: 16px;

                                        VerticalLayout {
                                            alignment: center;
                                            Text { text: "Active Window Class: " + root.diag_window_class; font_size: 12px; color: #C8CDD7; vertical_alignment: center; }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 48px;
                                    border_radius: 6px;
                                    background: #0d1017;
                                    border_width: 1px;
                                    border_color: #1a202c;

                                    HorizontalLayout {
                                        padding_left: 16px;
                                        padding_right: 16px;

                                        VerticalLayout {
                                            alignment: center;
                                            Text { text: "Hovered UI Element: " + root.diag_element_name; font_size: 12px; color: #C8CDD7; vertical_alignment: center; }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 48px;
                                    border_radius: 6px;
                                    background: #0d1017;
                                    border_width: 1px;
                                    border_color: #1a202c;

                                    HorizontalLayout {
                                        padding_left: 16px;
                                        padding_right: 16px;

                                        VerticalLayout {
                                            alignment: center;
                                            Text { text: "Resolved Item Path: " + root.diag_resolved_path; font_size: 12px; color: #C8CDD7; vertical_alignment: center; }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 48px;
                                    border_radius: 6px;
                                    background: #0d1017;
                                    border_width: 1px;
                                    border_color: #1a202c;

                                    HorizontalLayout {
                                        padding_left: 16px;
                                        padding_right: 16px;
                                        spacing: 16px;

                                        VerticalLayout {
                                            alignment: center;
                                            Text { text: "Detected Format: " + root.diag_detected_format; font_size: 12px; color: #C8CDD7; vertical_alignment: center; }
                                        }

                                        Rectangle { horizontal-stretch: 1; }

                                        VerticalLayout {
                                            alignment: center;
                                            StatusBadge { text: root.diag_status; badge_color: #248BFF20; text_color: #38BDF8; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Diagnostic Pipeline Architecture Guide
                    Rectangle {
                        border_radius: 8px;
                        background: #141824;
                        border_width: 1px;
                        border_color: #1e2638;
                        vertical-stretch: 0;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;

                            Text { text: "HOW EXPLORER INTEGRATION OPERATES"; font_size: 11px; font_weight: 700; color: #64748B; letter_spacing: 0.8px; }

                            HorizontalLayout {
                                spacing: 14px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    border_radius: 6px;
                                    background: #0d1017;
                                    border_width: 1px;
                                    border_color: #1a202c;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 4px;
                                        Text { text: "1. Keyboard Hook"; font_size: 12px; font_weight: 700; color: #38BDF8; }
                                        Text { text: "Intercepts low-level Alt press without blocking OS message dispatch or shortcuts."; font_size: 11px; color: #8C96A8; wrap: word-wrap; }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    border_radius: 6px;
                                    background: #0d1017;
                                    border_width: 1px;
                                    border_color: #1a202c;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 4px;
                                        Text { text: "2. Window Filter"; font_size: 12px; font_weight: 700; color: #38BDF8; }
                                        Text { text: "Verifies cursor or foreground belongs to CabinetWClass or Progman desktop."; font_size: 11px; color: #8C96A8; wrap: word-wrap; }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    border_radius: 6px;
                                    background: #0d1017;
                                    border_width: 1px;
                                    border_color: #1a202c;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 4px;
                                        Text { text: "3. UI Automation & COM"; font_size: 12px; font_weight: 700; color: #38BDF8; }
                                        Text { text: "Resolves genuine filesystem path via Shell IShellWindows and UIA element hit-test."; font_size: 11px; color: #8C96A8; wrap: word-wrap; }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    border_radius: 6px;
                                    background: #0d1017;
                                    border_width: 1px;
                                    border_color: #1a202c;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 4px;
                                        Text { text: "4. Donut Radial Wheel"; font_size: 12px; font_weight: 700; color: #38BDF8; }
                                        Text { text: "Queries conversion registry and maps annular wedge sectors with dead-zone handling."; font_size: 11px; color: #8C96A8; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }

    // ==================== ALL FORMATS PICKER & CAPABILITY MATRIX MODAL ====================
    if root.show_all_formats_modal: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #000000C8;

        // Backdrop Dismiss
        TouchArea {
            clicked => { root.show_all_formats_modal = false; }
        }

        // Modal Content Card
        Rectangle {
            x: (parent.width - 960px) / 2;
            y: (parent.height - 620px) / 2;
            width: 960px;
            height: 620px;
            border_radius: 10px;
            background: #141824;
            border_width: 1px;
            border_color: #1e2638;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000C0;

            TouchArea { /* Absorb clicks inside dialog */ }

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    vertical-stretch: 0;

                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "COMMAND PALETTE & FORMAT CATALOG (Ctrl+Shift+Space)"; font_size: 14px; font_weight: 800; color: #FFFFFF; letter_spacing: 0.5px; }
                        Text { text: "Search and select from 60+ verified formats, camera RAW profiles, 3D models, archives, and documents."; font_size: 11px; color: #8C96A8; }
                    }

                    DangerButton {
                        text: "✕ Close";
                        clicked => { root.show_all_formats_modal = false; }
                    }
                }

                // Search Bar
                SearchInput {
                    text <=> root.format_search_filter;
                    placeholder: "Type to search formats, extensions, categories (e.g. WebP, CR2, MP4, PDF, GLB, ZIP)...";
                    changed(query) => { root.format_search_changed(query); }
                }

                // Table Header
                Rectangle {
                    height: 32px;
                    border_radius: 6px;
                    background: #0d1017;
                    border_width: 1px;
                    border_color: #1a202c;
                    vertical-stretch: 0;

                    HorizontalLayout {
                        padding_left: 14px;
                        padding_right: 14px;
                        spacing: 12px;

                        Text { text: "FORMAT"; width: 80px; font_size: 10px; font_weight: 700; color: #64748B; vertical_alignment: center; }
                        Text { text: "CATEGORY"; width: 140px; font_size: 10px; font_weight: 700; color: #64748B; vertical_alignment: center; }
                        Text { text: "READ / WRITE"; width: 120px; font_size: 10px; font_weight: 700; color: #64748B; vertical_alignment: center; }
                        Text { text: "CONVERSION ENGINE"; width: 180px; font_size: 10px; font_weight: 700; color: #64748B; vertical_alignment: center; }
                        Text { text: "STATUS & LIMITATIONS"; horizontal-stretch: 1; font_size: 10px; font_weight: 700; color: #64748B; vertical_alignment: center; }
                        Text { text: "ACTION"; width: 100px; font_size: 10px; font_weight: 700; color: #64748B; horizontal_alignment: center; vertical_alignment: center; }
                    }
                }

                // Scrollable Matrix Table
                Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;

                        for item in root.capability_matrix: Rectangle {
                            height: 48px;
                            border_radius: 6px;
                            background: #0e121c;
                            border_width: 1px;
                            border_color: #1a2233;

                            HorizontalLayout {
                                padding_left: 14px;
                                padding_right: 14px;
                                spacing: 12px;
                                alignment: center;

                                // Format Badge
                                HorizontalLayout {
                                    width: 80px;
                                    alignment: start;
                                    Rectangle {
                                        width: 58px;
                                        height: 24px;
                                        border_radius: 4px;
                                        background: #1e2638;
                                        Text { text: "." + item.extension; font_size: 11px; font_weight: 800; color: #FFFFFF; horizontal_alignment: center; vertical_alignment: center; }
                                    }
                                }

                                // Category
                                Text { text: item.category; width: 140px; font_size: 11px; font_weight: 600; color: #94A3B8; vertical_alignment: center; }

                                // Read / Write Badges
                                HorizontalLayout {
                                    width: 120px;
                                    spacing: 6px;
                                    alignment: start;
                                    Rectangle {
                                        width: 44px;
                                        height: 20px;
                                        border_radius: 3px;
                                        background: item.can_decode ? #10B98120 : #33415540;
                                        Text { text: item.can_decode ? "DECODE" : "NO"; font_size: 9px; font_weight: 700; color: item.can_decode ? #10B981 : #64748B; horizontal_alignment: center; vertical_alignment: center; }
                                    }
                                    Rectangle {
                                        width: 44px;
                                        height: 20px;
                                        border_radius: 3px;
                                        background: item.can_encode ? #248BFF20 : #33415540;
                                        Text { text: item.can_encode ? "ENCODE" : "NO"; font_size: 9px; font_weight: 700; color: item.can_encode ? #38BDF8 : #64748B; horizontal_alignment: center; vertical_alignment: center; }
                                    }
                                }

                                // Engine
                                Text { text: item.engine; width: 180px; font_size: 11px; color: #C8CDD7; vertical_alignment: center; overflow: elide; }

                                // Status & Limitations
                                Text { text: item.status_label + " — " + item.limitations; horizontal-stretch: 1; font_size: 10px; color: #8C96A8; vertical_alignment: center; overflow: elide; }

                                // Action: Select Target
                                HorizontalLayout {
                                    width: 100px;
                                    alignment: center;
                                    if item.can_encode: SecondaryButton {
                                        text: "Select Target";
                                        clicked => {
                                            root.convert_target_fmt = item.name;
                                            root.select_target_format(item.name);
                                            root.show_all_formats_modal = false;
                                        }
                                    }
                                    if !item.can_encode: Text {
                                        text: "Input Only";
                                        font_size: 10px;
                                        color: #64748B;
                                        horizontal_alignment: center;
                                        vertical_alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Modal Footer
                Rectangle {
                    height: 28px;
                    vertical-stretch: 0;
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "💡 Camera RAW formats (CR2, NEF, ARW, DNG) are decode-only inputs. Choose PNG, JPG, or WebP to export."; font_size: 11px; color: #64748B; vertical_alignment: center; }
                        Text { text: "60+ Formats Supported • Native Rust & External Engines"; font_size: 11px; font_weight: 600; color: #38BDF8; vertical_alignment: center; }
                    }
                }
            }
        }
    }
}
